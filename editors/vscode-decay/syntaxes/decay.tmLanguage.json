{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Decay",
  "scopeName": "source.decay",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#host-globals" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.decay",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.decay",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.decay", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decay",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.decay",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(script|component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.decay" },
            "2": { "name": "entity.name.type.decay" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.decay" },
            "2": { "name": "entity.name.function.decay" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.decay",
          "match": "\\b(if|else|while|break|continue|return)\\b"
        },
        {
          "name": "storage.type.decay",
          "match": "\\b(let|var)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.decay",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.decay",
          "match": "\\b(f32|bool|String|string|unit|void)\\b"
        }
      ]
    },
    "host-globals": {
      "patterns": [
        {
          "name": "support.variable.decay",
          "match": "\\b(this|Input|World|Time|Game|Grid|Audio)\\b"
        }
      ]
    }
  }
}
