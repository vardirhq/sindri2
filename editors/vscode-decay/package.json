{
  "name": "sindri-decay",
  "displayName": "Sindri Decay",
  "description": "Decay language support for Sindri projects",
  "version": "0.1.0",
  "publisher": "vardir",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:decay"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "decay",
        "aliases": ["Decay", "decay"],
        "extensions": [".decay"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "decay",
        "scopeName": "source.decay",
        "path": "./syntaxes/decay.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Decay",
      "properties": {
        "decay.server.path": {
          "type": "string",
          "default": "decay-lsp",
          "description": "Path to the decay-lsp executable. The default uses PATH."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
