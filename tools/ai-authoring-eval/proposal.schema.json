{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sindri.dev/schemas/ai-authoring-proposal-v1.json",
  "title": "Sindri AI authoring proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "manifest_hash",
    "outcome",
    "label",
    "summary",
    "question",
    "operations"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "manifest_hash": { "type": "string", "minLength": 1 },
    "outcome": {
      "type": "string",
      "enum": ["proposal", "clarification", "answer", "refusal"]
    },
    "label": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "question": { "type": ["string", "null"] },
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "entity_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_id"],
          "properties": { "scene_id": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias"],
          "properties": { "alias": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "nullable_entity_ref": {
      "oneOf": [
        { "$ref": "#/$defs/entity_ref" },
        { "type": "null" }
      ]
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/$defs/set_scene_name" },
        { "$ref": "#/$defs/spawn" },
        { "$ref": "#/$defs/despawn" },
        { "$ref": "#/$defs/set_name" },
        { "$ref": "#/$defs/set_transform" },
        { "$ref": "#/$defs/set_parent" },
        { "$ref": "#/$defs/set_component" },
        { "$ref": "#/$defs/remove_component" },
        { "$ref": "#/$defs/set_disabled" }
      ]
    },
    "set_scene_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "name"],
      "properties": {
        "op": { "const": "set_scene_name" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "alias", "name", "parent", "components"],
      "properties": {
        "op": { "const": "spawn" },
        "alias": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/nullable_entity_ref" },
        "components": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "despawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity"],
      "properties": {
        "op": { "const": "despawn" },
        "entity": { "$ref": "#/$defs/entity_ref" }
      }
    },
    "set_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "name"],
      "properties": {
        "op": { "const": "set_name" },
        "entity": { "$ref": "#/$defs/entity_ref" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "set_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "translation", "rotation_degrees", "scale"],
      "properties": {
        "op": { "const": "set_transform" },
        "entity": { "$ref": "#/$defs/entity_ref" },
        "translation": { "$ref": "#/$defs/vector3" },
        "rotation_degrees": { "$ref": "#/$defs/vector3" },
        "scale": { "$ref": "#/$defs/vector3" }
      }
    },
    "set_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "parent"],
      "properties": {
        "op": { "const": "set_parent" },
        "entity": { "$ref": "#/$defs/entity_ref" },
        "parent": { "$ref": "#/$defs/nullable_entity_ref" }
      }
    },
    "set_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "type_name", "payload"],
      "properties": {
        "op": { "const": "set_component" },
        "entity": { "$ref": "#/$defs/entity_ref" },
        "type_name": { "type": "string", "minLength": 1 },
        "payload": {}
      }
    },
    "remove_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "type_name"],
      "properties": {
        "op": { "const": "remove_component" },
        "entity": { "$ref": "#/$defs/entity_ref" },
        "type_name": { "type": "string", "minLength": 1 }
      }
    },
    "set_disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "entity", "disabled"],
      "properties": {
        "op": { "const": "set_disabled" },
        "entity": { "$ref": "#/$defs/entity_ref" },
        "disabled": { "type": "boolean" }
      }
    }
  }
}
