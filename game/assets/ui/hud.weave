#title {
    width: 300px;
    height: 42px;
    x: 28px;
    y: -24px;
    anchor: top_left;
    color: #f2b84b;
    font-size: 30px;
    line-height: 36px;
    font-weight: 700;
    letter-spacing: 5px;
    text-align: start;
}

#kind {
    width: 300px;
    height: 30px;
    x: 28px;
    y: -70px;
    anchor: top_left;
    color: #dfe6f2;
    font-size: 20px;
    line-height: 26px;
    text-align: start;
}

#stock {
    width: 90px;
    height: 30px;
    x: 200px;
    y: -70px;
    anchor: top_left;
    color: #f2b84b;
    font-size: 20px;
    line-height: 26px;
    text-align: start;
}

#hint {
    width: 520px;
    height: 30px;
    x: 28px;
    y: 28px;
    anchor: bottom_left;
    color: #9aa6bb;
    font-size: 17px;
    line-height: 24px;
    text-align: start;
}

@media (max-width: 700px) {
    #title {
        width: 74vw;
        height: 11vw;
        x: 0px;
        y: -5vw;
        anchor: top;
        font-size: 7vw;
        line-height: 9vw;
        letter-spacing: 1vw;
        text-align: center;
    }

    #kind { width: 90vw; x: 0px; y: -17vw; anchor: top; font-size: 4.5vw;
             line-height: 6vw; text-align: center; }
    #stock { width: 90vw; x: 0px; y: -24vw; anchor: top; font-size: 4.5vw;
             line-height: 6vw; text-align: center; }
    #hint { width: 92vw; x: 0px; y: 4vw; anchor: bottom; font-size: 3.6vw;
            line-height: 5vw; text-align: center; }
}
