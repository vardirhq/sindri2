// Temporary phone diagnostic for Causeway Play input.
script Hud {
    fn update(dt: f32) {
        let kind = World.find("Kind");
        let stock = World.find("Stock");
        let debug = World.find("PlayDebug");
        if kind == null || stock == null {
            return;
        }

        let playing: bool = Game.get("playing", 0.0) > 0.5;
        let label = World.find("ModeLabel");
        if label != null {
            if playing {
                Ui.set_text(label, "PLAY");
            } else {
                Ui.set_text(label, "BUILD");
            }
        }

        if playing {
            Ui.set_text(kind, "tap to walk");
            Ui.set_text(stock, "");
            if debug != null {
                Ui.set_numbers(
                    debug,
                    Game.get("debug_tap", 0.0),
                    Game.get("debug_aim", 0.0),
                    Game.get("debug_ui", 0.0),
                    Game.get("debug_aim_x", 0.0),
                    Game.get("debug_aim_y", 0.0),
                    Game.get("debug_aim_z", 0.0)
                );
            }
            return;
        }

        if debug != null {
            Ui.set_text(debug, "");
        }
        if Game.get("arrived", 0.0) > 0.0 {
            Ui.set_text(kind, "The way is open.");
            Ui.set_text(stock, "");
            return;
        }
        let chosen = Game.get("chosen", 0.0);
        if chosen < 0.5 {
            Ui.set_text(kind, "planks");
        } else if chosen < 1.5 {
            Ui.set_text(kind, "earth");
        } else if chosen < 2.5 {
            Ui.set_text(kind, "stone");
        } else {
            Ui.set_text(kind, "railing");
        }
        Ui.set_number(stock, Game.get("left", 0.0));
    }
}
