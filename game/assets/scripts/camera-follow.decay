// Keeps the walker in frame while playing, and gets out of the way while
// building.
//
// Two modes want opposite things from a camera. Walking wants the walker kept
// in frame without being asked; building wants to go and look at somewhere
// else and stay there, which a camera that springs back to the walker makes
// impossible. So play follows and build is free.
//
// How far a drag moves the camera is the host's answer rather than this
// script's: it needs the view matrix and the viewport, and getting it wrong by
// a sign means the ground slides away from the finger instead of with it.
//
// The offset is exported rather than measured on the first frame, and the
// world being generated is why: the walker starts wherever this seed put dry
// land, so a camera that captured "where I am now, relative to them" would
// capture whatever gap the scene file happened to leave and keep it for ever.
// Stating the viewpoint makes it the same shot in every world.
script CameraFollow {
    @export
    let ease: f32 = 4.0;

    // How far the walker may move from the framed point before the camera
    // follows. The camera then moves only enough to keep it on this boundary,
    // rather than dragging the whole world for every fraction of a step.
    @export
    let dead_zone: f32 = 1.25;

    @export
    let height_dead_zone: f32 = 1.0;

    // A thirty-unit arm at forty-five degrees round and thirty-three up, which
    // is the isometric viewpoint this game is drawn from.
    @export
    let offset_x: f32 = 17.79;

    @export
    let offset_y: f32 = 16.34;

    @export
    let offset_z: f32 = 17.79;

    var framed: bool = false;

    fn update(dt: f32) {
        // Free while building: the drag moves the camera and nothing pulls it
        // back. Adding the pan unasked is right because it is zero whenever
        // nobody is dragging.
        if Game.get("playing", 0.0) < 0.5 {
            this.transform.position.x += Camera.pan_x;
            this.transform.position.y += Camera.pan_y;
            this.transform.position.z += Camera.pan_z;
            // Left alone, so switching back to play eases from wherever the
            // building left the view rather than snapping.
            framed = true;
            return;
        }

        let walker = World.find("Wanderer");
        if walker == null {
            return;
        }
        let want_x = walker.transform.position.x + offset_x;
        let want_y = walker.transform.position.y + offset_y;
        let want_z = walker.transform.position.z + offset_z;

        // The first frame snaps. Easing in from wherever the scene file left
        // the camera would be a long slow glide across the map before the game
        // started, once per run.
        if !framed {
            framed = true;
            this.transform.position.x = want_x;
            this.transform.position.y = want_y;
            this.transform.position.z = want_z;
            return;
        }

        var follow_x: f32 = this.transform.position.x;
        var follow_y: f32 = this.transform.position.y;
        var follow_z: f32 = this.transform.position.z;
        let dx = want_x - this.transform.position.x;
        let dy = want_y - this.transform.position.y;
        let dz = want_z - this.transform.position.z;

        if dx > dead_zone {
            follow_x = want_x - dead_zone;
        } else if dx < -dead_zone {
            follow_x = want_x + dead_zone;
        }
        if dy > height_dead_zone {
            follow_y = want_y - height_dead_zone;
        } else if dy < -height_dead_zone {
            follow_y = want_y + height_dead_zone;
        }
        if dz > dead_zone {
            follow_z = want_z - dead_zone;
        } else if dz < -dead_zone {
            follow_z = want_z + dead_zone;
        }

        let amount = 1.0 - exp(-ease * max(0.0, dt));
        this.transform.position.x += (follow_x - this.transform.position.x) * amount;
        this.transform.position.y += (follow_y - this.transform.position.y) * amount;
        this.transform.position.z += (follow_z - this.transform.position.z) * amount;
    }
}
