// A visible proof that authored walls reach gameplay through Decay.
script Wisp {
    @export
    let step_seconds: f32 = 0.32;

    var elapsed: f32 = 0.0;

    // Found once and held, rather than looked up by name every step. A held
    // reference outlives what it names, so each is re-checked before use and
    // found again when it stops naming anything.
    var floor: Entity;
    var player: Entity;

    fn update(dt: f32) {
        elapsed += dt;
        if elapsed < step_seconds {
            return;
        }
        // Keeping the remainder rather than resetting to zero, which would
        // round every step up to the end of the frame it landed in and tie the
        // wisp's cadence to the frame rate. `%` rather than one subtraction, so
        // a frame longer than a step does not leave a backlog to work off.
        elapsed %= step_seconds;

        if !World.exists(floor) {
            floor = World.find("Floor");
        }
        if !World.exists(player) {
            player = World.find("Player");
        }

        if floor != null && player != null {
            Grid.step_toward(this.entity, floor, player);
        }
    }
}
