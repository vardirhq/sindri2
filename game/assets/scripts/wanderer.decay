// The one who walks, and the reason any of it matters.
//
// Play owns movement: a tap moves the Target and the Wanderer routes toward it.
// Build owns the world instead, so switching to Build finishes any grid step
// already committed by pathfinding and then leaves the Wanderer where it is.
// What it cannot do in Play is walk somewhere there is no route to, so being
// told is still a request rather than an order.
script Wanderer {
    // Seconds a step takes. The pathfinder still commits one whole grid step,
    // while the transform crosses that step continuously for rendering.
    @export
    let step_seconds: f32 = 0.34;

    var moving: bool = false;
    var waiting: bool = true;
    var step_elapsed: f32 = 0.0;
    var from_x: f32 = 0.0;
    var from_y: f32 = 0.0;
    var from_z: f32 = 0.0;
    var to_x: f32 = 0.0;
    var to_y: f32 = 0.0;
    var to_z: f32 = 0.0;

    fn update(dt: f32) {
        let floor = World.find("Floor");
        let beacon = World.find("Beacon");
        if floor == null || beacon == null {
            return;
        }
        let playing: bool = Game.get("playing", 0.0) > 0.5;

        // Temporary Play-mode telemetry. Persist the last tap rather than the
        // current frame so a human can actually read what the input pipeline
        // decided after lifting a finger.
        if playing && Gesture.tapped {
            Game.set("debug_tap", 1.0);
            if Aim.hit {
                Game.set("debug_aim", 1.0);
                Game.set("debug_aim_x", Aim.x);
                Game.set("debug_aim_y", Aim.y);
                Game.set("debug_aim_z", Aim.z);
            } else {
                Game.set("debug_aim", 0.0);
            }
            if Pointer.over_ui {
                Game.set("debug_ui", 1.0);
                // Distinguish a recognised tap rejected by UI from no tap in
                // the two-value diagnostic HUD and the runtime regression.
                Game.set("debug_tap", 2.0);
            } else {
                Game.set("debug_ui", 0.0);
            }
        }

        // Where a tap said to go. Taken before movement advances, so a tap
        // lands on the frame it happened rather than waiting for a step.
        if playing && Gesture.tapped && Aim.hit && !Pointer.over_ui {
            let target = World.find("Target");
            if target != null {
                // Aim names a voxel as column, row, height. Grid.place takes
                // the same logical column and row; the host maps that row to
                // world Z for a solid grid and resolves height separately.
                Grid.place(target, floor, Aim.x, Aim.y);
            }
        }

        // Pathfinding commits the next grid cell before the transform eases
        // across it. If Build is entered mid-step, finish that already-committed
        // step so the rendered transform agrees with the logical grid cell,
        // then stop. Build must never choose a new navigation destination.
        if !playing {
            if moving {
                this.transform.position.x = to_x;
                this.transform.position.y = to_y;
                this.transform.position.z = to_z;
                moving = false;
                step_elapsed = 0.0;
            }
            if !waiting {
                waiting = true;
                Animation.stop(this.entity);
            }
            return;
        }

        let target = World.find("Target");
        if target == null {
            return;
        }
        let goal: Entity = target;

        // Ask pathfinding for the next whole cell up front, then put the
        // transform back and cross that chosen edge continuously. Route choices
        // remain grid-based while the picture no longer teleports a cell.
        if moving {
            step_elapsed += dt;
            let amount = min(1.0, step_elapsed / max(0.001, step_seconds));
            this.transform.position.x = from_x + (to_x - from_x) * amount;
            this.transform.position.y = from_y + (to_y - from_y) * amount;
            this.transform.position.z = from_z + (to_z - from_z) * amount;
            if amount < 1.0 {
                return;
            }
            moving = false;
            step_elapsed = 0.0;
        }

        // Asked every step rather than once, because the ground changes under
        // it: a route that existed a moment ago can be taken apart, and one
        // that did not can be built.
        if !Grid.can_reach(this.entity, floor, goal) {
            if !waiting {
                waiting = true;
                Animation.stop(this.entity);
            }
            return;
        }

        from_x = this.transform.position.x;
        from_y = this.transform.position.y;
        from_z = this.transform.position.z;

        // False when there is nowhere further to go, which on a route that
        // exists means it has arrived.
        if !Grid.step_toward(this.entity, floor, goal) {
            Game.set("arrived", 1.0);
            waiting = true;
            Animation.stop(this.entity);
            return;
        }

        to_x = this.transform.position.x;
        to_y = this.transform.position.y;
        to_z = this.transform.position.z;
        this.transform.position.x = from_x;
        this.transform.position.y = from_y;
        this.transform.position.z = from_z;
        moving = true;
        step_elapsed = 0.0;

        if waiting {
            waiting = false;
            Animation.play(this.entity, "bob");
        }
    }
}
