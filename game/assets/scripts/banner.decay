// The end of the game.
//
// Shown once every orb is gathered, and it fades in rather than appearing, so
// winning reads as something that happened rather than as a frame that changed.
script Banner {
    @export
    let orbs: f32 = 5.0;

    var shown: f32 = 0.0;
    var celebrated: bool = false;

    fn update(dt: f32) {
        if Game.get("score", 0.0) >= orbs {
            if !celebrated {
                Audio.play("audio/victory.wav", 0.9);
                celebrated = true;
            }
            shown = min(shown + dt * 2.0, 1.0);
        } else {
            shown = 0.0;
            celebrated = false;
        }
        this.ui_image.tint.a = shown;
    }
}
