// Spine is a body, not a hull with a health bar. Its head pulls a chain of
// breakable sections through the arena; destroying one severs the rear chain
// and turns that chain into a new moving threat.
script Spine {
    @export let view_size: f32 = 11.0;
    @export let shot: Prefab;
    @export let core: Prefab;
    @export let drop_roll: Prefab;
    @export let death_burst: Prefab;
    @export let segment: Prefab;
    @export let hazard_damage: f32 = 0.0;

    var hp: f32 = 0.0;
    var phase: f32 = 1.0;
    var previous_phase: f32 = 1.0;
    var clock: f32 = 0.0;
    var built: f32 = 0.0;
    var death_burst_damage: f32 = 0.0;
    var dir_x: f32 = 1.0;
    var dir_y: f32 = 0.0;
    var turn_clock: f32 = 0.0;

    fn start() {
        let elapsed = Game.get("elapsed", 0.0);
        let scale = 1.0 + min(1.35, max(0.0, elapsed - 60.0) * 0.0025);
        this.hp = 118.0 * scale;
        Game.set("boss_max", this.hp);
        Game.set("boss_hp", this.hp);
        Game.set("boss_kind", 8.0);
        let player = World.find("Player");
        if player != null { choose_turn(player); }
        build_body();
    }

    fn build_body() {
        if this.built > 0.0 { return; }
        this.built = 1.0;
        var slot: f32 = 0.0;
        while slot < 9.0 {
            let part = World.spawn(this.segment);
            part.transform.position.x =
                this.transform.position.x - this.dir_x * (slot + 1.0) * 0.62;
            part.transform.position.y =
                this.transform.position.y - this.dir_y * (slot + 1.0) * 0.62;
            World.set_property(part, "slot", slot);
            World.set_property(part, "group", 0.0);
            World.set_property(part, "head", 0.0);
            World.set_property(part, "health", 11.0);
            World.set_property(part, "spacing", 0.62);
            slot += 1.0;
        }
    }

    fn segment_count() -> f32 {
        var count: f32 = 0.0;
        for part in World.with_tag("spine_segment") {
            if World.exists(part) { count += 1.0; }
        }
        return count;
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        if this.hazard_damage > 0.0 {
            this.hp -= this.hazard_damage;
            this.hazard_damage = 0.0;
            if this.hp <= 0.0 { die(); return; }
        }
        let player = World.find("Player");
        if player == null { return; }

        this.clock += dt;
        this.turn_clock -= dt;
        update_phase();
        grid_move(player);
        receive_hits(player);
        Game.set("boss_hp", max(this.hp, 0.0));
        if this.hp <= 0.0 { die(); }
    }

    fn update_phase() {
        let parts = segment_count();
        if parts <= 3.0 { this.phase = 3.0; }
        else if parts <= 6.0 { this.phase = 2.0; }
        else { this.phase = 1.0; }

        if this.phase != this.previous_phase {
            this.previous_phase = this.phase;
            Effects.burst(this.entity);
            Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.35));
            Audio.play("audio/boss.wav", 0.5);
            if this.phase == 2.0 { Animation.play(this.entity, "armour8"); }
            if this.phase == 3.0 { Animation.play(this.entity, "armour5"); }
        }
    }

    fn receive_hits(player: Entity) {
        for hit in Physics.sensor_entered() {
            if hit == player {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), 2.2));
            } else if World.exists(hit) && World.has_tag(hit, "player_damage") {
                let damage = World.property_number(hit, "damage", 0.0);
                this.hp -= damage;
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
    }

    fn half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 * aspect - 0.9; }
        return this.view_size * 0.5 - 0.9;
    }

    fn half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 - 0.9; }
        return this.view_size * 0.5 / aspect - 0.9;
    }

    fn choose_turn(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        if abs(dx) > abs(dy) {
            this.dir_x = 1.0;
            if dx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
        } else {
            this.dir_x = 0.0;
            this.dir_y = 1.0;
            if dy < 0.0 { this.dir_y = -1.0; }
        }
        this.turn_clock = 0.48;
    }

    fn grid_move(player: Entity) {
        let hx = half_x();
        let hy = half_y();

        // Kinematic velocity can overshoot an edge between frames. Clamp first,
        // then choose the next cardinal direction from a position guaranteed to
        // be inside the visible arena.
        this.transform.position.x = max(-hx, min(hx, this.transform.position.x));
        this.transform.position.y = max(-hy, min(hy, this.transform.position.y));
        let x = this.transform.position.x;
        let y = this.transform.position.y;
        var must_turn: f32 = 0.0;
        if this.dir_x > 0.0 && x >= hx { must_turn = 1.0; }
        if this.dir_x < 0.0 && x <= -hx { must_turn = 1.0; }
        if this.dir_y > 0.0 && y >= hy { must_turn = 1.0; }
        if this.dir_y < 0.0 && y <= -hy { must_turn = 1.0; }
        if this.turn_clock <= 0.0 || must_turn > 0.0 { choose_turn(player); }

        if x >= hx && this.dir_x > 0.0 { this.dir_x = 0.0; this.dir_y = -1.0; }
        if x <= -hx && this.dir_x < 0.0 { this.dir_x = 0.0; this.dir_y = 1.0; }
        if y >= hy && this.dir_y > 0.0 { this.dir_y = 0.0; this.dir_x = 1.0; }
        if y <= -hy && this.dir_y < 0.0 { this.dir_y = 0.0; this.dir_x = -1.0; }

        var speed: f32 = 3.0;
        if this.phase == 2.0 { speed = 3.45; }
        if this.phase == 3.0 { speed = 3.9; }
        Physics.set_velocity(this.entity, this.dir_x * speed, this.dir_y * speed);
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn die() {
        for part in World.with_tag("spine_segment") {
            if World.exists(part) { Effects.burst(part); World.despawn(part); }
        }
        if this.death_burst_damage > 0.0 {
            let wave = World.spawn(this.death_burst);
            wave.transform.position.x = this.transform.position.x;
            wave.transform.position.y = this.transform.position.y;
            World.set_property(wave, "damage", this.death_burst_damage);
        }
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.95));
        Audio.play("audio/kill.wav", 0.65);
        Game.set("kills", Game.get("kills", 0.0) + 1.0);
        Game.set("score", Game.get("score", 0.0) + 900.0);
        Game.set("boss_hp", 0.0);
        Game.set("boss_max", 0.0);
        var made: f32 = 0.0;
        while made < 8.0 {
            let angle = made / 8.0 * 6.2831853;
            let drop = World.spawn(this.core);
            drop.transform.position.x = this.transform.position.x + cos(angle) * 1.2;
            drop.transform.position.y = this.transform.position.y + sin(angle) * 1.2;
            World.set_property(drop, "worth", 5.0);
            made += 1.0;
        }
        let roll = World.spawn(this.drop_roll);
        roll.transform.position.x = this.transform.position.x;
        roll.transform.position.y = this.transform.position.y;
        World.set_property(roll, "boss", 1.0);
        World.despawn(this.entity);
    }
}
