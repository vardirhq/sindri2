// Spine is a body, not a hull with a health bar. Its head pulls a chain of
// breakable sections through the arena; destroying one severs the rear chain
// and turns that chain into a new moving threat.
script Spine {
    @export let view_size: f32 = 11.0;
    @export let shot: Prefab;
    @export let core: Prefab;
    @export let drop_roll: Prefab;
    @export let death_burst: Prefab;
    @export let segment: Prefab;
    @export let hazard_damage: f32 = 0.0;
    @export let spine_marker: f32 = 1.0;

    var hp: f32 = 0.0;
    var phase: f32 = 1.0;
    var previous_phase: f32 = 1.0;
    var attack: f32 = 0.7;
    var special: f32 = 2.5;
    var clock: f32 = 0.0;
    var built: f32 = 0.0;
    var death_burst_damage: f32 = 0.0;

    fn start() {
        let elapsed = Game.get("elapsed", 0.0);
        let scale = 1.0 + min(1.35, max(0.0, elapsed - 60.0) * 0.0025);
        // The body sections carry a large share of the encounter durability, so
        // the head itself is deliberately lighter than the old monolithic boss.
        this.hp = 118.0 * scale;
        Game.set("boss_max", this.hp);
        Game.set("boss_hp", this.hp);
        Game.set("boss_kind", 8.0);
        build_body();
    }

    fn build_body() {
        if this.built > 0.0 { return; }
        this.built = 1.0;
        var slot: f32 = 0.0;
        while slot < 9.0 {
            let part = World.spawn(this.segment);
            part.transform.position.x = this.transform.position.x - (slot + 1.0) * 0.72;
            part.transform.position.y = this.transform.position.y;
            World.set_property(part, "slot", slot);
            World.set_property(part, "group", 0.0);
            World.set_property(part, "head", 0.0);
            World.set_property(part, "health", 11.0);
            World.set_property(part, "spacing", 0.72);
            slot += 1.0;
        }
    }

    fn segment_count() -> f32 {
        var count: f32 = 0.0;
        for part in World.with_tag("spine_segment") {
            if World.exists(part) { count += 1.0; }
        }
        return count;
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        if this.hazard_damage > 0.0 {
            this.hp -= this.hazard_damage;
            this.hazard_damage = 0.0;
            if this.hp <= 0.0 { die(); return; }
        }
        let player = World.find("Player");
        if player == null { return; }

        this.clock += dt;
        update_phase();
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);

        if is_visible() { act(dt, dx, dy, far); }
        else { chase(dx, dy, far, 1.0); }

        receive_hits(player);
        Game.set("boss_hp", max(this.hp, 0.0));
        if this.hp <= 0.0 { die(); }
    }

    fn update_phase() {
        let parts = segment_count();
        if parts <= 3.0 { this.phase = 3.0; }
        else if parts <= 6.0 { this.phase = 2.0; }
        else { this.phase = 1.0; }

        if this.phase != this.previous_phase {
            this.previous_phase = this.phase;
            this.attack = 0.2;
            this.special = 0.5;
            Effects.burst(this.entity);
            Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.35));
            Audio.play("audio/boss.wav", 0.5);
            if this.phase == 2.0 { Animation.play(this.entity, "armour8"); }
            if this.phase == 3.0 { Animation.play(this.entity, "armour5"); }
        }
    }

    fn receive_hits(player: Entity) {
        for hit in Physics.sensor_entered() {
            if hit == player {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), 2.2));
            } else if World.exists(hit) && World.has_tag(hit, "player_damage") {
                let damage = World.property_number(hit, "damage", 0.0);
                this.hp -= damage;
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
    }

    fn chase(dx: f32, dy: f32, far: f32, scale: f32) {
        if far <= 0.001 { return; }
        Physics.set_velocity(this.entity,
            dx / far * 1.15 * scale,
            dy / far * 1.15 * scale);
        this.transform.rotation_z = atan2(dy, dx);
    }

    fn snake(dx: f32, dy: f32, far: f32) {
        if far <= 0.001 { return; }
        let nx = dx / far;
        let ny = dy / far;
        var speed: f32 = 1.0;
        var bend: f32 = 0.62;
        if this.phase == 2.0 { speed = 1.18; bend = 0.82; }
        if this.phase == 3.0 { speed = 1.38; bend = 1.05; }
        let weave = sin(this.clock * (1.8 + this.phase * 0.35)) * bend;
        Physics.set_velocity(this.entity,
            nx * speed - ny * weave,
            ny * speed + nx * weave);
        this.transform.rotation_z = atan2(dy, dx);
    }

    fn fire_at(angle: f32, velocity: f32, damage: f32) {
        let bolt = World.spawn(this.shot);
        bolt.transform.position.x = this.transform.position.x + cos(angle) * 0.65;
        bolt.transform.position.y = this.transform.position.y + sin(angle) * 0.65;
        World.set_property(bolt, "dir_x", cos(angle));
        World.set_property(bolt, "dir_y", sin(angle));
        World.set_property(bolt, "speed", velocity);
        World.set_property(bolt, "damage", damage);
    }

    fn fire_fan(dx: f32, dy: f32, count: f32, velocity: f32, spread: f32) {
        let base = atan2(dy, dx);
        let half = (count - 1.0) * 0.5;
        var slot: f32 = 0.0;
        while slot < count {
            fire_at(base + (slot - half) * spread, velocity, 1.0);
            slot += 1.0;
        }
        Audio.play("audio/boss.wav", 0.34);
    }

    fn fire_body_wave() {
        // Each surviving section contributes a shot. As the body fragments the
        // volume falls, but the independent heads make movement less predictable.
        for part in World.with_tag("spine_segment") {
            if !World.exists(part) { continue; }
            let angle = this.clock * 0.9 + World.property_number(part, "slot", 0.0) * 0.55;
            let bolt = World.spawn(this.shot);
            bolt.transform.position.x = part.transform.position.x;
            bolt.transform.position.y = part.transform.position.y;
            World.set_property(bolt, "dir_x", cos(angle));
            World.set_property(bolt, "dir_y", sin(angle));
            World.set_property(bolt, "speed", 3.2 + this.phase * 0.35);
            World.set_property(bolt, "damage", 1.0);
        }
        Audio.play("audio/boss.wav", 0.42);
    }

    fn act(dt: f32, dx: f32, dy: f32, far: f32) {
        snake(dx, dy, far);
        this.attack -= dt;
        this.special -= dt;

        if this.attack <= 0.0 {
            var count: f32 = 3.0;
            var speed: f32 = 4.0;
            if this.phase == 2.0 { count = 5.0; speed = 4.5; }
            if this.phase == 3.0 { count = 7.0; speed = 5.0; }
            fire_fan(dx, dy, count, speed, 0.16);
            this.attack = max(0.62, 1.18 - this.phase * 0.16);
        }

        if this.special <= 0.0 {
            fire_body_wave();
            this.special = max(1.55, 3.15 - this.phase * 0.48);
        }
    }

    fn visible_half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 * aspect; }
        return this.view_size * 0.5;
    }

    fn visible_half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5; }
        return this.view_size * 0.5 / aspect;
    }

    fn is_visible() -> bool {
        let half_x = visible_half_x();
        let half_y = visible_half_y();
        let radius = max(abs(this.transform.scale.x), abs(this.transform.scale.y)) * 0.5;
        return this.transform.position.x + radius >= -half_x &&
               this.transform.position.x - radius <= half_x &&
               this.transform.position.y + radius >= -half_y &&
               this.transform.position.y - radius <= half_y;
    }

    fn die() {
        // The head dying kills the encounter, including any severed rear chains.
        for part in World.with_tag("spine_segment") {
            if World.exists(part) { Effects.burst(part); World.despawn(part); }
        }
        if this.death_burst_damage > 0.0 {
            let wave = World.spawn(this.death_burst);
            wave.transform.position.x = this.transform.position.x;
            wave.transform.position.y = this.transform.position.y;
            World.set_property(wave, "damage", this.death_burst_damage);
        }
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.95));
        Audio.play("audio/kill.wav", 0.65);
        Game.set("kills", Game.get("kills", 0.0) + 1.0);
        Game.set("score", Game.get("score", 0.0) + 900.0);
        Game.set("boss_hp", 0.0);
        Game.set("boss_max", 0.0);
        var made: f32 = 0.0;
        while made < 8.0 {
            let angle = made / 8.0 * 6.2831853;
            let drop = World.spawn(this.core);
            drop.transform.position.x = this.transform.position.x + cos(angle) * 1.2;
            drop.transform.position.y = this.transform.position.y + sin(angle) * 1.2;
            World.set_property(drop, "worth", 5.0);
            made += 1.0;
        }
        let roll = World.spawn(this.drop_roll);
        roll.transform.position.x = this.transform.position.x;
        roll.transform.position.y = this.transform.position.y;
        World.set_property(roll, "boss", 1.0);
        World.despawn(this.entity);
    }
}
