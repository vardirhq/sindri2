// One independent section of Spine's body.
//
// Like an Aegis shield plate, every section owns its own script, health,
// collider and kinematic body. What connects Spine is a runtime cardinal trail:
// each section receives a corner from the piece ahead, reaches that coordinate,
// then hands the same corner to the next piece. The route therefore propagates
// through the body instead of being broadcast ahead of the body itself.
script SpineSegment {
    @export let slot: f32 = 0.0;
    @export var group: f32 = 0.0;
    @export var head: f32 = 0.0;
    @export let health: f32 = 10.0;
    @export let spacing: f32 = 0.62;
    @export var spawn_x: f32 = 0.0;
    @export var spawn_y: f32 = 0.0;
    @export var initial_dir_x: f32 = 1.0;
    @export var initial_dir_y: f32 = 0.0;

    var hp: f32 = 0.0;
    var state: f32 = 0.0;
    var dir_x: f32 = 1.0;
    var dir_y: f32 = 0.0;
    var consumed_turn_serial: f32 = 0.0;
    var issued_turn_serial: f32 = 0.0;
    var corner_count: f32 = 0.0;
    var corner_x: f32 = 0.0;
    var corner_y: f32 = 0.0;
    var next_corner_x: f32 = 0.0;
    var next_corner_y: f32 = 0.0;
    var turn_clock: f32 = 0.0;

    fn start() {
        this.hp = this.health;
        this.dir_x = this.initial_dir_x;
        this.dir_y = this.initial_dir_y;
        this.transform.position.x = this.spawn_x;
        this.transform.position.y = this.spawn_y;
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn spine() -> Entity {
        for boss in World.with_tag("spine") {
            if World.exists(boss) { return boss; }
        }
        return null;
    }

    fn leader() -> Entity {
        if this.head > 0.0 { return null; }
        if this.group == 0.0 && this.slot == 0.0 { return spine(); }
        let wanted = this.slot - 1.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            if World.property_number(part, "slot", -99.0) == wanted {
                return part;
            }
        }
        return null;
    }

    fn next_member() -> Entity {
        let wanted = this.slot + 1.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            if World.property_number(part, "slot", -99.0) == wanted {
                return part;
            }
        }
        return null;
    }

    fn adopt_split_messages() {
        let new_group = World.take_signal("spine_rekey");
        if new_group > 0.0 {
            this.group = new_group;
            // Accept the promoted head's new serial stream, but keep every
            // queued corner. Those points are the surviving rear chain's route
            // through turns it has not reached yet.
            this.consumed_turn_serial = 0.0;
            let next = next_member();
            if next != null { World.send_signal(next, "spine_rekey", new_group); }
        }

        let promote = World.take_signal("spine_promote");
        if promote > 0.0 {
            this.group = promote;
            this.head = 1.0;
            this.issued_turn_serial = 0.0;
            this.consumed_turn_serial = 0.0;
            this.corner_count = 0.0;
            this.turn_clock = 1.50;

            let vx = Physics.velocity_x(this.entity);
            let vy = Physics.velocity_y(this.entity);
            if abs(vx) > 0.01 {
                this.dir_x = 1.0;
                if vx < 0.0 { this.dir_x = -1.0; }
                this.dir_y = 0.0;
            } else if abs(vy) > 0.01 {
                this.dir_x = 0.0;
                this.dir_y = 1.0;
                if vy < 0.0 { this.dir_y = -1.0; }
            } else {
                let player = World.find("Player");
                if player != null { choose_initial_direction(player); }
            }
        }
    }

    fn consume_turn_signal() {
        let serial = World.take_signal("spine_turn_serial");
        if serial <= 0.0 { return; }
        let x = World.take_signal("spine_turn_x");
        let y = World.take_signal("spine_turn_y");
        if serial <= this.consumed_turn_serial { return; }
        this.consumed_turn_serial = serial;

        if this.corner_count <= 0.0 {
            this.corner_x = x;
            this.corner_y = y;
            this.corner_count = 1.0;
        } else {
            this.next_corner_x = x;
            this.next_corner_y = y;
            this.corner_count = 2.0;
        }
    }

    fn forward_corner(x: f32, y: f32) {
        let next = next_member();
        if next == null { return; }
        this.issued_turn_serial += 1.0;
        World.send_signal(next, "spine_turn_x", x);
        World.send_signal(next, "spine_turn_y", y);
        World.send_signal(next, "spine_turn_serial", this.issued_turn_serial);
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }

        adopt_split_messages();
        consume_turn_signal();
        receive_hits();
        if !World.exists(this.entity) { return; }
        if this.head > 0.0 { grid_hunt(dt); return; }

        let ahead = leader();
        if ahead == null {
            this.head = 1.0;
            this.group = this.slot + 1.0;
            this.issued_turn_serial = 0.0;
            this.consumed_turn_serial = 0.0;
            this.corner_count = 0.0;
            this.turn_clock = 1.50;
            let player = World.find("Player");
            if player != null { choose_initial_direction(player); }
            grid_hunt(dt);
            return;
        }
        follow(ahead, dt);
    }

    fn axis_velocity(distance: f32, dt: f32, speed: f32) -> f32 {
        if abs(distance) <= 0.0001 { return 0.0; }
        return max(-speed, min(speed, distance / max(dt, 0.0001)));
    }

    fn follow_corner(dt: f32, speed: f32) -> bool {
        while this.corner_count > 0.0 {
            let dx = this.corner_x - this.transform.position.x;
            let dy = this.corner_y - this.transform.position.y;
            var vx: f32 = 0.0;
            var vy: f32 = 0.0;
            // Finish the lane we entered on before taking the corner.
            // Choosing X merely because of tiny cross-axis drift lets a vertical
            // follower peel sideways before it has reached the recorded point.
            if abs(this.dir_x) > abs(this.dir_y) {
                if abs(dx) > 0.0001 { vx = axis_velocity(dx, dt, speed); }
                else if abs(dy) > 0.0001 { vy = axis_velocity(dy, dt, speed); }
            } else {
                if abs(dy) > 0.0001 { vy = axis_velocity(dy, dt, speed); }
                else if abs(dx) > 0.0001 { vx = axis_velocity(dx, dt, speed); }
            }
            if abs(vx) <= 0.0001 && abs(vy) <= 0.0001 {
                // This section has now genuinely visited the predecessor's
                // corner. Only now may the next section learn about that corner.
                forward_corner(this.corner_x, this.corner_y);
                this.corner_count -= 1.0;
                this.corner_x = this.next_corner_x;
                this.corner_y = this.next_corner_y;
                continue;
            }
            Physics.set_velocity(this.entity, vx, vy);
            if abs(vx) > 0.0001 {
                this.dir_x = 1.0;
                if vx < 0.0 { this.dir_x = -1.0; }
                this.dir_y = 0.0;
            } else {
                this.dir_x = 0.0;
                this.dir_y = 1.0;
                if vy < 0.0 { this.dir_y = -1.0; }
            }
            this.transform.rotation_z = atan2(vy, vx);
            return true;
        }
        return false;
    }

    fn follow(ahead: Entity, dt: f32) {
        let avx = Physics.velocity_x(ahead);
        let avy = Physics.velocity_y(ahead);
        let speed = max(abs(avx), abs(avy));

        if follow_corner(dt, speed) { return; }

        // The spawn offset already establishes the gap. Copying the leader's
        // cardinal velocity preserves that gap along a straight lane. Trying
        // to reconstruct a point `spacing` behind the leader after a corner
        // sends the follower backwards into space the leader never visited.
        Physics.set_velocity(this.entity, avx, avy);
        if abs(avx) > 0.01 {
            this.dir_x = 1.0;
            if avx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
            this.transform.rotation_z = atan2(avy, avx);
        } else if abs(avy) > 0.01 {
            this.dir_x = 0.0;
            this.dir_y = 1.0;
            if avy < 0.0 { this.dir_y = -1.0; }
            this.transform.rotation_z = atan2(avy, avx);
        }
    }

    fn publish_group_turn(x: f32, y: f32) {
        let next = next_member();
        if next == null { return; }
        this.issued_turn_serial += 1.0;
        World.send_signal(next, "spine_turn_x", x);
        World.send_signal(next, "spine_turn_y", y);
        World.send_signal(next, "spine_turn_serial", this.issued_turn_serial);
    }

    fn half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 * aspect - 0.9; }
        return 11.0 * 0.5 - 0.9;
    }

    fn half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 - 0.9; }
        return 11.0 * 0.5 / aspect - 0.9;
    }

    fn choose_initial_direction(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        if abs(dx) > abs(dy) {
            this.dir_x = 1.0; if dx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
        } else {
            this.dir_x = 0.0;
            this.dir_y = 1.0; if dy < 0.0 { this.dir_y = -1.0; }
        }
    }

    fn turn_from_vertical_lane(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        this.dir_x = 1.0;
        if dx < 0.0 { this.dir_x = -1.0; }
        this.dir_y = 0.0;
    }

    fn turn_from_horizontal_lane(player: Entity) {
        let dy = player.transform.position.y - this.transform.position.y;
        this.dir_x = 0.0;
        this.dir_y = 1.0;
        if dy < 0.0 { this.dir_y = -1.0; }
    }

    fn grid_hunt(dt: f32) {
        let player = World.find("Player");
        if player == null { return; }
        let hx = half_x();
        let hy = half_y();
        let x = this.transform.position.x;
        let y = this.transform.position.y;
        let margin = 0.12;
        var turning: f32 = 0.0;
        this.turn_clock -= dt;

        if this.dir_x > 0.0 && x >= hx - margin { turning = 1.0; turn_from_horizontal_lane(player); }
        else if this.dir_x < 0.0 && x <= -hx + margin { turning = 1.0; turn_from_horizontal_lane(player); }
        else if this.dir_y > 0.0 && y >= hy - margin { turning = 1.0; turn_from_vertical_lane(player); }
        else if this.dir_y < 0.0 && y <= -hy + margin { turning = 1.0; turn_from_vertical_lane(player); }
        else if this.turn_clock <= 0.0 {
            turning = 1.0;
            if abs(this.dir_x) > 0.0 { turn_from_horizontal_lane(player); }
            else { turn_from_vertical_lane(player); }
        }

        if turning > 0.0 {
            publish_group_turn(x, y);
            this.turn_clock = 1.50;
        }
        Physics.set_velocity(this.entity, this.dir_x * 3.55, this.dir_y * 3.55);
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn receive_hits() {
        this.hp -= World.take_signal("hazard_damage");
        for hit in Physics.sensor_entered() {
            if !World.exists(hit) { continue; }
            if World.has_tag(hit, "player_damage") {
                this.hp -= World.property_number(hit, "damage", 0.0);
                World.despawn(hit);
            } else if World.has_tag(hit, "player") {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), 1.7));
            }
        }
        if this.hp <= 0.0 { split(); return; }
        let share = this.hp / max(this.health, 0.001);
        if share < 0.34 && this.state < 2.0 {
            this.state = 2.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.30;
            this.sprite.tint.b = 0.40;
        } else if share < 0.67 && this.state < 1.0 {
            this.state = 1.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.46;
            this.sprite.tint.b = 0.60;
        }
    }

    fn split() {
        let new_group = this.slot + 1.0;
        let next = next_member();
        if next != null {
            // Rekeying walks rearward one surviving neighbour at a time. A
            // missing slot is the physical cut, so propagation cannot cross
            // into a fragment that was already separated earlier.
            World.send_signal(next, "spine_rekey", new_group);
            World.send_signal(next, "spine_promote", new_group);
        }

        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.22));
        Audio.play("audio/kill.wav", 0.25);
        World.despawn(this.entity);
    }
}
