// One section of Spine's body. A section replays the cardinal route taken by
// the one in front. This is deliberately deterministic snake movement rather
// than a physical rope: every section visits the same corners without joint
// forces dragging it diagonally across the arena.
script SpineSegment {
    @export let slot: f32 = 0.0;
    @export var group: f32 = 0.0;
    @export var head: f32 = 0.0;
    @export let health: f32 = 10.0;
    @export let spacing: f32 = 0.62;

    var hp: f32 = 0.0;
    var state: f32 = 0.0;
    var dir_x: f32 = 1.0;
    var dir_y: f32 = 0.0;
    var turn_clock: f32 = 0.0;
    var seen_dir_x: f32 = 0.0;
    var seen_dir_y: f32 = 0.0;
    var corner_count: f32 = 0.0;
    var corner_x: f32 = 0.0;
    var corner_y: f32 = 0.0;
    var next_corner_x: f32 = 0.0;
    var next_corner_y: f32 = 0.0;

    fn start() {
        this.hp = this.health;
    }

    fn spine() -> Entity {
        for boss in World.with_tag("spine") {
            if World.exists(boss) {
                return boss;
            }
        }
        return null;
    }

    fn leader() -> Entity {
        if this.head > 0.0 { return null; }
        if this.group == 0.0 && this.slot == 0.0 { return spine(); }
        let wanted = this.slot - 1.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            if World.property_number(part, "group", -1.0) == this.group &&
               World.property_number(part, "slot", -99.0) == wanted {
                return part;
            }
        }
        return null;
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        this.turn_clock -= dt;
        receive_hits();
        if !World.exists(this.entity) { return; }
        if this.head > 0.0 { grid_hunt(); return; }
        let ahead = leader();
        if ahead == null {
            // If the predecessor disappeared for any reason, this becomes a
            // genuine severed head instead of freezing as an orphaned link.
            this.head = 1.0;
            grid_hunt();
            return;
        }
        follow(ahead, dt);
    }

    fn axis_velocity(distance: f32, dt: f32, speed: f32) -> f32 {
        if abs(distance) <= 0.0001 { return 0.0; }
        return max(-speed, min(speed, distance / max(dt, 0.0001)));
    }

    fn remember_turn(ax: f32, ay: f32, avx: f32, avy: f32) {
        var next_x: f32 = 0.0;
        var next_y: f32 = 0.0;
        if abs(avx) > 0.01 {
            next_x = 1.0;
            if avx < 0.0 { next_x = -1.0; }
        } else if abs(avy) > 0.01 {
            next_y = 1.0;
            if avy < 0.0 { next_y = -1.0; }
        } else {
            return;
        }

        if this.seen_dir_x == 0.0 && this.seen_dir_y == 0.0 {
            this.seen_dir_x = next_x;
            this.seen_dir_y = next_y;
            return;
        }
        if this.seen_dir_x == next_x && this.seen_dir_y == next_y { return; }

        // The predecessor may already have travelled part-way down its new lane
        // when this script observes the direction change. Recover the actual
        // corner as the intersection of that new lane and the lane this follower
        // is still travelling. Unlike rewinding by dt, this is independent of
        // script/physics update ordering and lands on the predecessor's route.
        var turn_x: f32 = ax;
        var turn_y: f32 = ay;
        if abs(this.seen_dir_x) > 0.01 {
            turn_y = this.transform.position.y;
        } else if abs(this.seen_dir_y) > 0.01 {
            turn_x = this.transform.position.x;
        }

        if this.corner_count <= 0.0 {
            this.corner_x = turn_x;
            this.corner_y = turn_y;
            this.corner_count = 1.0;
        } else {
            this.next_corner_x = turn_x;
            this.next_corner_y = turn_y;
            this.corner_count = 2.0;
        }
        this.seen_dir_x = next_x;
        this.seen_dir_y = next_y;
    }

    fn follow_corner(dt: f32, speed: f32) -> bool {
        while this.corner_count > 0.0 {
            let dx = this.corner_x - this.transform.position.x;
            let dy = this.corner_y - this.transform.position.y;
            var vx: f32 = 0.0;
            var vy: f32 = 0.0;
            if abs(dx) > 0.0001 { vx = axis_velocity(dx, dt, speed); }
            else if abs(dy) > 0.0001 { vy = axis_velocity(dy, dt, speed); }
            else {
                this.corner_count -= 1.0;
                this.corner_x = this.next_corner_x;
                this.corner_y = this.next_corner_y;
                continue;
            }
            Physics.set_velocity(this.entity, vx, vy);
            this.transform.rotation_z = atan2(vy, vx);
            return true;
        }
        return false;
    }

    fn follow(ahead: Entity, dt: f32) {
        let ax = ahead.transform.position.x;
        let ay = ahead.transform.position.y;
        let avx = Physics.velocity_x(ahead);
        let avy = Physics.velocity_y(ahead);
        let speed = 5.4;
        let aligned = 0.0001;
        var vx: f32 = 0.0;
        var vy: f32 = 0.0;

        remember_turn(ax, ay, avx, avy);
        if follow_corner(dt, speed) { return; }

        // Finish the predecessor's old lane before entering its new one. Only
        // one velocity component is ever non-zero, and the final step is sized
        // to land exactly on the coordinate rather than leaving a snap error.
        if abs(avx) >= abs(avy) && abs(avx) > 0.01 {
            let cross = ay - this.transform.position.y;
            if abs(cross) > aligned {
                vy = axis_velocity(cross, dt, speed);
            } else {
                var target_x = ax - this.spacing;
                if avx < 0.0 { target_x = ax + this.spacing; }
                let along = target_x - this.transform.position.x;
                vx = axis_velocity(along, dt, speed);
            }
        } else if abs(avy) > 0.01 {
            let cross = ax - this.transform.position.x;
            if abs(cross) > aligned {
                vx = axis_velocity(cross, dt, speed);
            } else {
                var target_y = ay - this.spacing;
                if avy < 0.0 { target_y = ay + this.spacing; }
                let along = target_y - this.transform.position.y;
                vy = axis_velocity(along, dt, speed);
            }
        } else {
            let dx = ax - this.transform.position.x;
            let dy = ay - this.transform.position.y;
            if abs(dx) > abs(dy) {
                if dx > this.spacing { vx = speed; }
                if dx < -this.spacing { vx = -speed; }
            } else {
                if dy > this.spacing { vy = speed; }
                if dy < -this.spacing { vy = -speed; }
            }
        }

        Physics.set_velocity(this.entity, vx, vy);
        if abs(vx) + abs(vy) > 0.01 {
            this.transform.rotation_z = atan2(vy, vx);
        }
    }

    fn half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 * aspect - 0.9; }
        return 11.0 * 0.5 - 0.9;
    }

    fn half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 - 0.9; }
        return 11.0 * 0.5 / aspect - 0.9;
    }

    fn choose_turn(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        if abs(dx) > abs(dy) {
            this.dir_x = 1.0; if dx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
        } else {
            this.dir_x = 0.0;
            this.dir_y = 1.0; if dy < 0.0 { this.dir_y = -1.0; }
        }
        this.turn_clock = 0.55;
    }

    fn grid_hunt() {
        let player = World.find("Player");
        if player == null { return; }
        let hx = half_x();
        let hy = half_y();
        let x = this.transform.position.x;
        let y = this.transform.position.y;
        var edge: f32 = 0.0;
        if this.dir_x > 0.0 && x >= hx { edge = 1.0; }
        if this.dir_x < 0.0 && x <= -hx { edge = 1.0; }
        if this.dir_y > 0.0 && y >= hy { edge = 1.0; }
        if this.dir_y < 0.0 && y <= -hy { edge = 1.0; }
        if this.turn_clock <= 0.0 || edge > 0.0 { choose_turn(player); }
        if x >= hx && this.dir_x > 0.0 { this.dir_x = 0.0; this.dir_y = -1.0; }
        if x <= -hx && this.dir_x < 0.0 { this.dir_x = 0.0; this.dir_y = 1.0; }
        if y >= hy && this.dir_y > 0.0 { this.dir_y = 0.0; this.dir_x = 1.0; }
        if y <= -hy && this.dir_y < 0.0 { this.dir_y = 0.0; this.dir_x = -1.0; }
        Physics.set_velocity(this.entity, this.dir_x * 3.55, this.dir_y * 3.55);
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn receive_hits() {
        this.hp -= World.take_signal("hazard_damage");
        for hit in Physics.sensor_entered() {
            if !World.exists(hit) { continue; }
            if World.has_tag(hit, "player_damage") {
                this.hp -= World.property_number(hit, "damage", 0.0);
                World.despawn(hit);
            } else if World.has_tag(hit, "player") {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), 1.7));
            }
        }
        if this.hp <= 0.0 { split(); return; }
        let share = this.hp / max(this.health, 0.001);
        if share < 0.34 && this.state < 2.0 {
            this.state = 2.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.30;
            this.sprite.tint.b = 0.40;
        } else if share < 0.67 && this.state < 1.0 {
            this.state = 1.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.46;
            this.sprite.tint.b = 0.60;
        }
    }

    fn split() {
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.22));
        Audio.play("audio/kill.wav", 0.25);
        // On its own update, the next section sees that its predecessor is gone
        // and promotes its own live `head` field. A running script owns that
        // field; another script cannot rewrite its authored starting properties.
        World.despawn(this.entity);
    }
}
