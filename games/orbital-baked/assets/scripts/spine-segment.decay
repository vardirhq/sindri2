// One independent section of Spine's body.
//
// Like an Aegis shield plate, every section owns its own script, health,
// collider and kinematic body. The difference is what connects the pieces:
// Aegis shares an orbit, Spine shares an authoritative cardinal trail. A
// section never guesses where the one ahead turned. Its chain head publishes
// the exact corner and every member replays that same coordinate.
script SpineSegment {
    @export let slot: f32 = 0.0;
    @export var group: f32 = 0.0;
    @export var head: f32 = 0.0;
    @export let health: f32 = 10.0;
    @export let spacing: f32 = 0.62;
    @export var spawn_x: f32 = 0.0;
    @export var spawn_y: f32 = 0.0;
    @export var initial_dir_x: f32 = 1.0;
    @export var initial_dir_y: f32 = 0.0;
    @export var turn_serial: f32 = 0.0;
    @export var turn_x: f32 = 0.0;
    @export var turn_y: f32 = 0.0;

    var hp: f32 = 0.0;
    var state: f32 = 0.0;
    var dir_x: f32 = 1.0;
    var dir_y: f32 = 0.0;
    var consumed_turn_serial: f32 = 0.0;
    var issued_turn_serial: f32 = 0.0;
    var corner_count: f32 = 0.0;
    var corner_x: f32 = 0.0;
    var corner_y: f32 = 0.0;
    var next_corner_x: f32 = 0.0;
    var next_corner_y: f32 = 0.0;

    fn start() {
        this.hp = this.health;
        this.dir_x = this.initial_dir_x;
        this.dir_y = this.initial_dir_y;
        // Same fix that made Aegis's independent plates reliable: establish
        // the entity's actual world pose during start(), before the kinematic
        // physics body is materialised on the following synchronization pass.
        this.transform.position.x = this.spawn_x;
        this.transform.position.y = this.spawn_y;
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn spine() -> Entity {
        for boss in World.with_tag("spine") {
            if World.exists(boss) { return boss; }
        }
        return null;
    }

    fn leader() -> Entity {
        if this.head > 0.0 { return null; }
        if this.group == 0.0 && this.slot == 0.0 { return spine(); }
        let wanted = this.slot - 1.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            if World.property_number(part, "group", -1.0) == this.group &&
               World.property_number(part, "slot", -99.0) == wanted {
                return part;
            }
        }
        return null;
    }

    fn promote_chain() {
        let old_group = this.group;
        let new_group = this.slot + 1.0;
        this.group = new_group;
        this.head = 1.0;
        this.issued_turn_serial = this.turn_serial;

        // The rear is now a real independent chain, not a collection of
        // orphans. Re-key every later member so the original head can no longer
        // publish corners into this chain and this new head can.
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            let part_slot = World.property_number(part, "slot", -99.0);
            let part_group = World.property_number(part, "group", -1.0);
            if part_group == old_group && part_slot > this.slot {
                World.set_property(part, "group", new_group);
            }
        }

        // Continue along the route we were already travelling. A split should
        // not create a magical corner just because a section became a head.
        let vx = Physics.velocity_x(this.entity);
        let vy = Physics.velocity_y(this.entity);
        if abs(vx) > 0.01 {
            this.dir_x = 1.0;
            if vx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
        } else if abs(vy) > 0.01 {
            this.dir_x = 0.0;
            this.dir_y = 1.0;
            if vy < 0.0 { this.dir_y = -1.0; }
        } else {
            let player = World.find("Player");
            if player != null { choose_initial_direction(player); }
        }
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        receive_hits();
        if !World.exists(this.entity) { return; }
        if this.head > 0.0 { grid_hunt(); return; }

        let ahead = leader();
        if ahead == null {
            promote_chain();
            grid_hunt();
            return;
        }
        follow(ahead, dt);
    }

    fn axis_velocity(distance: f32, dt: f32, speed: f32) -> f32 {
        if abs(distance) <= 0.0001 { return 0.0; }
        return max(-speed, min(speed, distance / max(dt, 0.0001)));
    }

    fn consume_published_turn() {
        if this.turn_serial <= this.consumed_turn_serial { return; }
        this.consumed_turn_serial = this.turn_serial;
        if this.corner_count <= 0.0 {
            this.corner_x = this.turn_x;
            this.corner_y = this.turn_y;
            this.corner_count = 1.0;
        } else {
            this.next_corner_x = this.turn_x;
            this.next_corner_y = this.turn_y;
            this.corner_count = 2.0;
        }
    }

    fn follow_corner(dt: f32, speed: f32) -> bool {
        while this.corner_count > 0.0 {
            let dx = this.corner_x - this.transform.position.x;
            let dy = this.corner_y - this.transform.position.y;
            var vx: f32 = 0.0;
            var vy: f32 = 0.0;
            if abs(dx) > 0.0001 { vx = axis_velocity(dx, dt, speed); }
            else if abs(dy) > 0.0001 { vy = axis_velocity(dy, dt, speed); }
            else {
                this.corner_count -= 1.0;
                this.corner_x = this.next_corner_x;
                this.corner_y = this.next_corner_y;
                continue;
            }
            Physics.set_velocity(this.entity, vx, vy);
            this.transform.rotation_z = atan2(vy, vx);
            return true;
        }
        return false;
    }

    fn follow(ahead: Entity, dt: f32) {
        let ax = ahead.transform.position.x;
        let ay = ahead.transform.position.y;
        let avx = Physics.velocity_x(ahead);
        let avy = Physics.velocity_y(ahead);
        let speed = 5.4;
        let aligned = 0.0001;
        var vx: f32 = 0.0;
        var vy: f32 = 0.0;

        consume_published_turn();
        if follow_corner(dt, speed) { return; }

        // Between authoritative corners this member simply maintains spacing
        // on the predecessor's current lane. There is no turn detection here.
        if abs(avx) >= abs(avy) && abs(avx) > 0.01 {
            let cross = ay - this.transform.position.y;
            if abs(cross) > aligned {
                vy = axis_velocity(cross, dt, speed);
            } else {
                var target_x = ax - this.spacing;
                if avx < 0.0 { target_x = ax + this.spacing; }
                vx = axis_velocity(target_x - this.transform.position.x, dt, speed);
            }
        } else if abs(avy) > 0.01 {
            let cross = ax - this.transform.position.x;
            if abs(cross) > aligned {
                vx = axis_velocity(cross, dt, speed);
            } else {
                var target_y = ay - this.spacing;
                if avy < 0.0 { target_y = ay + this.spacing; }
                vy = axis_velocity(target_y - this.transform.position.y, dt, speed);
            }
        }

        Physics.set_velocity(this.entity, vx, vy);
        if abs(vx) + abs(vy) > 0.01 {
            this.transform.rotation_z = atan2(vy, vx);
        }
    }

    fn publish_group_turn(x: f32, y: f32) {
        this.issued_turn_serial += 1.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            if World.property_number(part, "group", -1.0) != this.group { continue; }
            if World.property_number(part, "head", 0.0) > 0.0 { continue; }
            World.set_property(part, "turn_x", x);
            World.set_property(part, "turn_y", y);
            World.set_property(part, "turn_serial", this.issued_turn_serial);
        }
    }

    fn half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 * aspect - 0.9; }
        return 11.0 * 0.5 - 0.9;
    }

    fn half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 - 0.9; }
        return 11.0 * 0.5 / aspect - 0.9;
    }

    fn choose_initial_direction(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        if abs(dx) > abs(dy) {
            this.dir_x = 1.0; if dx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
        } else {
            this.dir_x = 0.0;
            this.dir_y = 1.0; if dy < 0.0 { this.dir_y = -1.0; }
        }
    }

    fn turn_from_vertical_edge(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        this.dir_x = 1.0;
        if dx < 0.0 { this.dir_x = -1.0; }
        this.dir_y = 0.0;
    }

    fn turn_from_horizontal_edge(player: Entity) {
        let dy = player.transform.position.y - this.transform.position.y;
        this.dir_x = 0.0;
        this.dir_y = 1.0;
        if dy < 0.0 { this.dir_y = -1.0; }
    }

    fn grid_hunt() {
        let player = World.find("Player");
        if player == null { return; }
        let hx = half_x();
        let hy = half_y();
        let x = this.transform.position.x;
        let y = this.transform.position.y;
        let margin = 0.12;
        var turning: f32 = 0.0;

        if this.dir_x > 0.0 && x >= hx - margin { turning = 1.0; turn_from_horizontal_edge(player); }
        else if this.dir_x < 0.0 && x <= -hx + margin { turning = 1.0; turn_from_horizontal_edge(player); }
        else if this.dir_y > 0.0 && y >= hy - margin { turning = 1.0; turn_from_vertical_edge(player); }
        else if this.dir_y < 0.0 && y <= -hy + margin { turning = 1.0; turn_from_vertical_edge(player); }

        if turning > 0.0 { publish_group_turn(x, y); }
        Physics.set_velocity(this.entity, this.dir_x * 3.55, this.dir_y * 3.55);
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn receive_hits() {
        this.hp -= World.take_signal("hazard_damage");
        for hit in Physics.sensor_entered() {
            if !World.exists(hit) { continue; }
            if World.has_tag(hit, "player_damage") {
                this.hp -= World.property_number(hit, "damage", 0.0);
                World.despawn(hit);
            } else if World.has_tag(hit, "player") {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), 1.7));
            }
        }
        if this.hp <= 0.0 { split(); return; }
        let share = this.hp / max(this.health, 0.001);
        if share < 0.34 && this.state < 2.0 {
            this.state = 2.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.30;
            this.sprite.tint.b = 0.40;
        } else if share < 0.67 && this.state < 1.0 {
            this.state = 1.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.46;
            this.sprite.tint.b = 0.60;
        }
    }

    fn split() {
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.22));
        Audio.play("audio/kill.wav", 0.25);
        World.despawn(this.entity);
    }
}
