// One physical section of Spine's body. Sections follow the section in front
// of them until one is destroyed; the severed rear chain promotes its first
// surviving section into a new cardinal-moving head.
script SpineSegment {
    @export let slot: f32 = 0.0;
    @export var group: f32 = 0.0;
    @export var head: f32 = 0.0;
    @export let health: f32 = 10.0;
    @export let spacing: f32 = 0.62;

    var hp: f32 = 0.0;
    var state: f32 = 0.0;
    var dir_x: f32 = 1.0;
    var dir_y: f32 = 0.0;
    var turn_clock: f32 = 0.0;

    fn start() { this.hp = this.health; }

    fn spine() -> Entity {
        for boss in World.with_tag("boss") {
            if World.exists(boss) && World.property_number(boss, "spine_marker", 0.0) > 0.0 {
                return boss;
            }
        }
        return null;
    }

    fn leader() -> Entity {
        if this.head > 0.0 { return null; }
        if this.group == 0.0 && this.slot == 0.0 { return spine(); }
        let wanted = this.slot - 1.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            if World.property_number(part, "group", -1.0) == this.group &&
               World.property_number(part, "slot", -99.0) == wanted {
                return part;
            }
        }
        return null;
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        this.turn_clock -= dt;
        clamp_inside();
        receive_hits();
        if !World.exists(this.entity) { return; }
        if this.head > 0.0 { grid_hunt(); return; }
        let ahead = leader();
        if ahead == null {
            this.head = 1.0;
            grid_hunt();
            return;
        }
        follow(ahead);
    }

    fn follow(ahead: Entity) {
        let ax = ahead.transform.position.x;
        let ay = ahead.transform.position.y;
        let avx = Physics.velocity_x(ahead);
        let avy = Physics.velocity_y(ahead);
        let speed = 5.8;
        let snap = 0.055;
        var target_x: f32 = ax;
        var target_y: f32 = ay;

        // Target one body-length behind the leader on the leader's actual travel
        // axis. No diagonal target exists anywhere in this system.
        if abs(avx) >= abs(avy) && abs(avx) > 0.01 {
            if avx > 0.0 { target_x = ax - this.spacing; }
            else { target_x = ax + this.spacing; }
        } else if abs(avy) > 0.01 {
            if avy > 0.0 { target_y = ay - this.spacing; }
            else { target_y = ay + this.spacing; }
        }

        let dx = target_x - this.transform.position.x;
        let dy = target_y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);

        // This is the invariant the previous versions lacked: a body section is
        // never allowed to drift far enough away to stop reading as connected.
        // If physics/order-of-update creates a gap, repair it immediately rather
        // than asking nine independent followers to eventually catch up.
        if far > this.spacing * 1.55 {
            this.transform.position.x = target_x;
            this.transform.position.y = target_y;
            Physics.set_velocity(this.entity, avx, avy);
            if abs(avx) + abs(avy) > 0.01 {
                this.transform.rotation_z = atan2(avy, avx);
            }
            return;
        }

        var vx: f32 = 0.0;
        var vy: f32 = 0.0;
        // Reach the leader's lane first, then travel along it. At the exact
        // target inherit the leader velocity instead of stopping for a frame;
        // that old zero-velocity state cascaded down the chain and could freeze it.
        if abs(avx) >= abs(avy) && abs(avx) > 0.01 {
            if abs(dy) > snap {
                if dy > 0.0 { vy = speed; } else { vy = -speed; }
            } else {
                this.transform.position.y = target_y;
                if abs(dx) > snap {
                    if dx > 0.0 { vx = speed; } else { vx = -speed; }
                } else {
                    this.transform.position.x = target_x;
                    vx = avx;
                    vy = avy;
                }
            }
        } else if abs(avy) > 0.01 {
            if abs(dx) > snap {
                if dx > 0.0 { vx = speed; } else { vx = -speed; }
            } else {
                this.transform.position.x = target_x;
                if abs(dy) > snap {
                    if dy > 0.0 { vy = speed; } else { vy = -speed; }
                } else {
                    this.transform.position.y = target_y;
                    vx = avx;
                    vy = avy;
                }
            }
        } else {
            // A leader can report zero velocity for a single update around a
            // clamp/turn. Keep closing the tether rather than freezing.
            if abs(dx) > abs(dy) {
                if dx > snap { vx = speed; }
                else if dx < -snap { vx = -speed; }
            } else {
                if dy > snap { vy = speed; }
                else if dy < -snap { vy = -speed; }
            }
        }

        Physics.set_velocity(this.entity, vx, vy);
        if abs(vx) + abs(vy) > 0.01 {
            this.transform.rotation_z = atan2(vy, vx);
        }
    }

    fn half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 * aspect - 0.9; }
        return 11.0 * 0.5 - 0.9;
    }

    fn half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return 11.0 * 0.5 - 0.9; }
        return 11.0 * 0.5 / aspect - 0.9;
    }

    fn clamp_inside() {
        let hx = half_x();
        let hy = half_y();
        this.transform.position.x = max(-hx, min(hx, this.transform.position.x));
        this.transform.position.y = max(-hy, min(hy, this.transform.position.y));
    }

    fn choose_turn(player: Entity) {
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        if abs(dx) > abs(dy) {
            this.dir_x = 1.0; if dx < 0.0 { this.dir_x = -1.0; }
            this.dir_y = 0.0;
        } else {
            this.dir_x = 0.0;
            this.dir_y = 1.0; if dy < 0.0 { this.dir_y = -1.0; }
        }
        this.turn_clock = 0.55;
    }

    fn grid_hunt() {
        let player = World.find("Player");
        if player == null { return; }
        let hx = half_x();
        let hy = half_y();
        clamp_inside();
        let x = this.transform.position.x;
        let y = this.transform.position.y;
        var edge: f32 = 0.0;
        if this.dir_x > 0.0 && x >= hx { edge = 1.0; }
        if this.dir_x < 0.0 && x <= -hx { edge = 1.0; }
        if this.dir_y > 0.0 && y >= hy { edge = 1.0; }
        if this.dir_y < 0.0 && y <= -hy { edge = 1.0; }
        if this.turn_clock <= 0.0 || edge > 0.0 { choose_turn(player); }
        if x >= hx && this.dir_x > 0.0 { this.dir_x = 0.0; this.dir_y = -1.0; }
        if x <= -hx && this.dir_x < 0.0 { this.dir_x = 0.0; this.dir_y = 1.0; }
        if y >= hy && this.dir_y > 0.0 { this.dir_y = 0.0; this.dir_x = 1.0; }
        if y <= -hy && this.dir_y < 0.0 { this.dir_y = 0.0; this.dir_x = -1.0; }
        Physics.set_velocity(this.entity, this.dir_x * 3.55, this.dir_y * 3.55);
        this.transform.rotation_z = atan2(this.dir_y, this.dir_x);
    }

    fn receive_hits() {
        for hit in Physics.sensor_entered() {
            if !World.exists(hit) { continue; }
            if World.has_tag(hit, "player_damage") {
                this.hp -= World.property_number(hit, "damage", 0.0);
                World.despawn(hit);
            } else if World.has_tag(hit, "player") {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), 1.7));
            }
        }
        if this.hp <= 0.0 { split(); return; }
        let share = this.hp / max(this.health, 0.001);
        if share < 0.34 && this.state < 2.0 {
            this.state = 2.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.30;
            this.sprite.tint.b = 0.40;
        } else if share < 0.67 && this.state < 1.0 {
            this.state = 1.0;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.46;
            this.sprite.tint.b = 0.60;
        }
    }

    fn split() {
        let old_group = this.group;
        let new_group = this.slot + 1.0;
        var promoted: f32 = 0.0;
        for part in World.with_tag("spine_segment") {
            if part == this.entity || !World.exists(part) { continue; }
            let part_group = World.property_number(part, "group", -1.0);
            let part_slot = World.property_number(part, "slot", -1.0);
            if part_group == old_group && part_slot > this.slot {
                World.set_property(part, "group", new_group);
                if promoted == 0.0 && part_slot == this.slot + 1.0 {
                    World.set_property(part, "head", 1.0);
                    promoted = 1.0;
                }
            }
        }
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.22));
        Audio.play("audio/kill.wav", 0.25);
        World.despawn(this.entity);
    }
}
