// Destructible Outer Drift asteroid. Large and medium bodies split into the
// next authored size; collider radii live in the prefabs so visuals and hits
// stay honest instead of relying on transform scale.
script HazardAsteroid {
    @export let health: f32 = 5.0;
    @export let impact_damage: f32 = 0.7;
    @export var vx: f32 = 0.0;
    @export var vy: f32 = 0.5;
    @export let child_count: f32 = 2.0;
    @export let child: Prefab;
    @export let view_size: f32 = 11.0;

    var hp: f32 = 0.0;
    var drift_x: f32 = 0.0;
    var drift_y: f32 = 0.0;
    var spin: f32 = 0.0;
    var phase: f32 = 0.0;
    var age: f32 = 0.0;
    var impact_cd: f32 = 0.0;
    var hit_flash: f32 = 0.0;
    var suspended: bool = false;

    fn start() {
        this.hp = this.health;
        this.drift_x = this.vx;
        this.drift_y = this.vy;
        this.spin = Random.range(-0.55, 0.55);
        this.phase = Random.range(0.0, 6.2831853);
        this.suspended = false;
        author_rock();
        Physics.set_velocity(this.entity, this.drift_x, this.drift_y);
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 || Game.get("sector", 0.0) != 1.0 {
            // Preserve whatever momentum physics produced before freezing for an
            // overlay/sector transition. Resume from that momentum once play returns.
            if !this.suspended {
                this.drift_x = Physics.velocity_x(this.entity);
                this.drift_y = Physics.velocity_y(this.entity);
                this.suspended = true;
            }
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.transform.rotation_z = this.phase + this.age * this.spin;
            return;
        }

        if this.suspended {
            Physics.set_velocity(this.entity, this.drift_x, this.drift_y);
            this.suspended = false;
        }

        // During active play physics owns velocity. Do not re-author drift every
        // frame: impacts between asteroids, player shoves and future forces must
        // be allowed to change their momentum naturally.
        this.age += dt;
        this.impact_cd = max(0.0, this.impact_cd - dt);
        this.hit_flash = max(0.0, this.hit_flash - dt);
        this.transform.rotation_z = this.phase + this.age * this.spin;
        update_damage_visual();
        wrap();
        let player = World.find("Player");
        for hit in Physics.sensor_entered() {
            handle_hit(hit, player);
        }
        for hit in Physics.collision_started() {
            handle_hit(hit, player);
        }

        if this.hp <= 0.0 {
            split();
            Effects.burst(this.entity);
            World.despawn(this.entity);
        }
    }

    fn handle_hit(hit: Entity, player: Entity) {
        if hit == player {
            if this.impact_cd <= 0.0 {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), this.impact_damage));
                this.impact_cd = 0.55;
                knock_from(player);
            }
            return;
        }
        if !World.exists(hit) { return; }
        if World.has_tag(hit, "player_damage") {
            this.hp -= World.property_number(hit, "damage", 0.0);
            this.hit_flash = 0.14;
        }
    }

    fn wrap() {
        let edge_x = visible_half_x() + 1.2;
        let edge_y = visible_half_y() + 1.2;
        if this.transform.position.x < -edge_x { this.transform.position.x = edge_x; }
        else if this.transform.position.x > edge_x { this.transform.position.x = -edge_x; }
        if this.transform.position.y < -edge_y { this.transform.position.y = edge_y; }
        else if this.transform.position.y > edge_y { this.transform.position.y = -edge_y; }
    }

    fn split() {
        if this.child_count <= 0.0 { return; }
        var total: f32 = this.child_count;
        if total > 2.0 { total = Random.int(2.0, 3.0); }
        var made: f32 = 0.0;
        while made < total {
            let angle = Random.range(0.0, 6.2831853);
            let speed = Random.range(0.43, 0.96);
            let piece = World.spawn(this.child);
            piece.transform.position.x = this.transform.position.x + cos(angle) * 0.35;
            piece.transform.position.y = this.transform.position.y + sin(angle) * 0.35;
            World.set_property(piece, "vx", Physics.velocity_x(this.entity) + cos(angle) * speed);
            World.set_property(piece, "vy", Physics.velocity_y(this.entity) + sin(angle) * speed);
            made += 1.0;
        }
    }

    fn author_rock() {
    }

    fn update_damage_visual() {
        let damage = 1.0 - this.hp / max(this.health, 0.001);
        if this.hit_flash > 0.0 {
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 1.0;
            this.sprite.tint.b = 1.0;
        } else {
            this.sprite.tint.r = 0.47 + damage * 0.28;
            this.sprite.tint.g = 0.58 + damage * 0.24;
            this.sprite.tint.b = 0.65 + damage * 0.20;
        }
    }

    fn knock_from(player: Entity) {
        if player == null { return; }
        let dx = this.transform.position.x - player.transform.position.x;
        let dy = this.transform.position.y - player.transform.position.y;
        let far = max(0.1, sqrt(dx * dx + dy * dy));
        Physics.apply_impulse(this.entity, dx / far * 1.1, dy / far * 1.1);
    }

    fn visible_half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 * aspect; }
        return this.view_size * 0.5;
    }

    fn visible_half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5; }
        return this.view_size * 0.5 / aspect;
    }
}
