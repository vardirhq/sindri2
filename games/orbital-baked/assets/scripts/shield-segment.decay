// One independent plate of Aegis's rotating shield.
//
// Each plate owns its own script, health, collider and kinematic body. The
// script drives the physics body around the boss instead of moving only the
// visible transform. That keeps sprite and collider on the same entity and in
// the same place, so a shot that visually reaches a plate actually hits it.
script ShieldSegment {
    @export let angle: f32 = 0.0;
    @export let radius: f32 = 1.5;
    @export let spin: f32 = 0.5;
    @export let health: f32 = 8.0;

    var hp: f32 = 0.0;
    var state: f32 = -1.0;
    var turn: f32 = 0.0;

    fn start() {
        this.hp = this.health;
        place_on_ring();
        wear(2.0, "whole");
    }

    fn boss() -> Entity {
        for boss in World.with_tag("boss") {
            if World.exists(boss) { return boss; }
        }
        return null;
    }

    // Spawn directly on the ring before the physics body is materialised on the
    // following synchronization pass. This avoids eight plates briefly existing
    // at the world origin and gives the kinematic body the right initial pose.
    fn place_on_ring() {
        let hull = boss();
        if hull == null { return; }
        let a = this.angle + this.turn;
        this.transform.position.x = hull.transform.position.x + cos(a) * this.radius;
        this.transform.position.y = hull.transform.position.y + sin(a) * this.radius;
        // The artwork is authored facing away from the core at rotation 0, so
        // its visual rotation should always match its current radial angle.
        this.transform.rotation_z = a;
    }

    fn update(dt: f32) {
        let hull = boss();
        if hull == null {
            World.despawn(this.entity);
            return;
        }

        this.turn += this.spin * dt;
        let a = this.angle + this.turn;
        let target_x = hull.transform.position.x + cos(a) * this.radius;
        let target_y = hull.transform.position.y + sin(a) * this.radius;

        // The body is velocity-kinematic, so physics owns its actual world pose.
        // Correct toward the exact orbital target while also carrying the plate
        // tangentially around the ring. The correction term makes the ring stay
        // attached while Aegis itself moves.
        let error_x = target_x - this.transform.position.x;
        let error_y = target_y - this.transform.position.y;
        let tangent_x = -sin(a) * this.radius * this.spin;
        let tangent_y = cos(a) * this.radius * this.spin;
        Physics.set_velocity(this.entity,
            error_x * 12.0 + tangent_x,
            error_y * 12.0 + tangent_y);

        // Position is physics-owned, but the plate still has to turn with the
        // orbit visually. Previously this was only set once at spawn, so after
        // a few seconds each plate had moved around the ring while still facing
        // its original direction.
        this.transform.rotation_z = a;

        receive_hits();
    }

    fn receive_hits() {
        for hit in Physics.sensor_entered() {
            if World.exists(hit) && World.has_tag(hit, "player_damage") {
                this.hp -= World.property_number(hit, "damage", 0.0);
                // The plate is authoritative. A projectile that reached it is
                // gone now, not on the bullet script's next update.
                World.despawn(hit);
            }
        }
        if this.hp <= 0.0 {
            Effects.burst(this.entity);
            Audio.play("audio/kill.wav", 0.22);
            World.despawn(this.entity);
            return;
        }
        let share = this.hp / max(this.health, 0.001);
        if share > 0.66 { wear(2.0, "whole"); }
        else if share > 0.33 { wear(1.0, "cracked"); }
        else { wear(0.0, "failing"); }
    }

    fn wear(next: f32, clip: String) {
        if next == this.state { return; }
        this.state = next;
        Animation.play(this.entity, clip);
    }
}
