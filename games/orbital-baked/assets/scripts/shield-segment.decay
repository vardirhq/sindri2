// One plate of a boss's rotating shield.
//
// The mechanic this exists for is entirely physical. A projectile that reaches
// a plate is consumed by that plate immediately, before the same physics step can
// also report the hull behind it. Destroy one and the gap it leaves is a real
// firing lane because there is nothing there to consume the projectile anymore.
script ShieldSegment {
    @export let angle: f32 = 0.0;
    @export let radius: f32 = 1.5;
    @export let spin: f32 = 0.5;
    @export let health: f32 = 8.0;

    var hp: f32 = 0.0;
    var state: f32 = -1.0;
    var turn: f32 = 0.0;

    fn start() {
        this.hp = this.health;
        wear(2.0, "whole");
    }

    fn update(dt: f32) {
        var cx: f32 = 0.0;
        var cy: f32 = 0.0;
        var found: f32 = 0.0;
        for boss in World.with_tag("boss") {
            if World.exists(boss) {
                cx = boss.transform.position.x;
                cy = boss.transform.position.y;
                found = 1.0;
            }
        }
        if found == 0.0 {
            World.despawn(this.entity);
            return;
        }

        this.turn += this.spin * dt;
        let a = this.angle + this.turn;
        this.transform.position.x = cx + cos(a) * this.radius;
        this.transform.position.y = cy + sin(a) * this.radius;
        this.transform.rotation_z = a;
        receive_hits();
    }

    fn receive_hits() {
        for hit in Physics.sensor_entered() {
            if World.exists(hit) && World.has_tag(hit, "player_damage") {
                this.hp -= World.property_number(hit, "damage", 0.0);
                // Do not leave the projectile alive until its own next update.
                // That allowed one fast shot to register on both plate and hull
                // during the same physics step.
                World.despawn(hit);
            }
        }
        if this.hp <= 0.0 {
            Effects.burst(this.entity);
            Audio.play("audio/kill.wav", 0.22);
            World.despawn(this.entity);
            return;
        }
        let share = this.hp / max(this.health, 0.001);
        if share > 0.66 { wear(2.0, "whole"); }
        else if share > 0.33 { wear(1.0, "cracked"); }
        else { wear(0.0, "failing"); }
    }

    fn wear(next: f32, clip: String) {
        if next == this.state {
            return;
        }
        this.state = next;
        Animation.play(this.entity, clip);
    }
}
