// A desperation beam with a readable warning line. It does not become lethal
// until the telegraph expires, so random directions are threatening rather
// than cheap.
script AegisLaser {
    @export let angle: f32 = 0.0;
    @export let length: f32 = 13.0;
    @export let telegraph: f32 = 0.62;
    @export let live_time: f32 = 0.24;
    @export let damage: f32 = 2.8;

    var age: f32 = 0.0;
    var fired: bool = false;
    var dealt: bool = false;
    var origin_x: f32 = 0.0;
    var origin_y: f32 = 0.0;

    fn start() {
        this.origin_x = this.transform.position.x;
        this.origin_y = this.transform.position.y;
        place();
        telegraph_visual();
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            World.despawn(this.entity);
            return;
        }
        this.age += dt;
        if !this.fired && this.age >= this.telegraph {
            this.fired = true;
            fire_visual();
            Effects.burst(this.entity);
            Audio.play("audio/boss.wav", 0.52);
        }
        if this.fired {
            hit_player();
            if this.age >= this.telegraph + this.live_time {
                World.despawn(this.entity);
            }
        } else {
            let pulse = 0.22 + (sin(this.age * 24.0) + 1.0) * 0.12;
            this.shape.fill.a = pulse;
            this.shape.stroke.a = min(0.9, pulse + 0.34);
        }
    }

    fn place() {
        let nx = cos(this.angle);
        let ny = sin(this.angle);
        this.transform.position.x = this.origin_x + nx * this.length * 0.5;
        this.transform.position.y = this.origin_y + ny * this.length * 0.5;
        this.transform.rotation_z = this.angle;
        this.transform.scale.x = this.length;
    }

    fn telegraph_visual() {
        this.transform.scale.y = 0.035;
        this.shape.fill.r = 1.0; this.shape.fill.g = 0.12; this.shape.fill.b = 0.06; this.shape.fill.a = 0.3;
        this.shape.stroke.r = 1.0; this.shape.stroke.g = 0.62; this.shape.stroke.b = 0.22; this.shape.stroke.a = 0.72;
    }

    fn fire_visual() {
        this.transform.scale.y = 0.24;
        this.shape.fill.r = 1.0; this.shape.fill.g = 0.88; this.shape.fill.b = 0.62; this.shape.fill.a = 0.94;
        this.shape.stroke.r = 1.0; this.shape.stroke.g = 0.2; this.shape.stroke.b = 0.06; this.shape.stroke.a = 1.0;
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.22));
    }

    fn hit_player() {
        if this.dealt { return; }
        let player = World.find("Player");
        if player == null { return; }
        let dx = player.transform.position.x - this.origin_x;
        let dy = player.transform.position.y - this.origin_y;
        let nx = cos(this.angle);
        let ny = sin(this.angle);
        let forward = dx * nx + dy * ny;
        if forward < 0.0 || forward > this.length { return; }
        let sideways = abs(-dx * ny + dy * nx);
        if sideways <= 0.22 {
            this.dealt = true;
            Game.set("player_damage_taken", max(Game.get("player_damage_taken", 0.0), this.damage));
        }
    }
}
