// What the Warden fires. It only knows how to travel and how long it lasts.
script HostileShot {
    @export let speed: f32 = 3.4;
    @export let life: f32 = 5.0;
    @export let dir_x: f32 = 0.0;
    @export let dir_y: f32 = 1.0;
    @export let damage: f32 = 1.0;

    var age: f32 = 0.0;
    var trail: Entity = null;
    var trail_clock: f32 = 0.0;

    fn start() {
        this.trail = World.find("TrailHostile");
        Physics.set_velocity(this.entity, this.dir_x * this.speed, this.dir_y * this.speed);
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        this.age += dt;
        this.transform.rotation_z += dt * 4.0;
        let pulse = 1.0 + sin(this.age * 16.0) * 0.14;
        this.transform.scale.x = 0.18 * pulse;
        this.transform.scale.y = 0.18 * pulse;
        this.trail_clock -= dt;
        if this.trail != null && this.trail_clock <= 0.0 {
            this.trail_clock = 0.035;
            Effects.burst_at(this.trail, this.transform.position.x, this.transform.position.y);
        }
        if this.age >= this.life {
            World.despawn(this.entity);
            return;
        }
        for hit in Physics.sensor_entered() {
            Game.set("player_damage_taken",
                     max(Game.get("player_damage_taken", 0.0), this.damage));
            World.despawn(this.entity);
            return;
        }
    }
}
