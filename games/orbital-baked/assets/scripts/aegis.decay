// A fortress you dismantle one plate at a time. Every opening is both a way
// in and a way out. When the ring is gone, the damaged core becomes a desperate
// bullet-hell weapon.
script Aegis {
    @export let view_size: f32 = 11.0;
    @export let shot: Prefab;
    @export let core: Prefab;
    @export let drop_roll: Prefab;
    @export let death_burst: Prefab;
    @export let hazard_damage: f32 = 0.0;
    @export let shield_segment: Prefab;
    @export let desperation_laser: Prefab;

    var hp: f32 = 0.0;
    var phase: f32 = 1.0;
    var previous_phase: f32 = 1.0;
    var attack: f32 = 0.75;
    var special: f32 = 2.7;
    var clock: f32 = 0.0;
    var offset: f32 = 0.0;
    var phase_flash: f32 = 0.0;
    var death_burst_damage: f32 = 0.0;
    var ring_built: f32 = 0.0;

    fn start() {
        let elapsed = Game.get("elapsed", 0.0);
        let scale = 1.0 + min(1.35, max(0.0, elapsed - 60.0) * 0.0025);
        // The plates are part of Aegis's effective durability. Keep the exposed
        // hull below the other heavy bosses so dismantling the ring feels like
        // real progress instead of revealing a second full health bar.
        this.hp = 150.0 * scale;
        this.offset = Random.range(0.0, 6.2831853);
        Game.set("boss_max", this.hp);
        Game.set("boss_hp", this.hp);
        Game.set("boss_kind", 11.0);
        Game.set("aegis_core_exposed", 0.0);
        tint();
    }

    fn tint() {
        if this.phase == 3.0 {
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 0.62;
            this.sprite.tint.b = 0.38;
        } else {
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 1.0;
            this.sprite.tint.b = 1.0;
        }
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        if this.hazard_damage > 0.0 {
            this.hp -= this.hazard_damage;
            this.hazard_damage = 0.0;
            if this.hp <= 0.0 { die(); return; }
        }
        let player = World.find("Player");
        if player == null { return; }

        build_shield_ring();
        this.clock += dt;
        update_phase(dt);
        var spin: f32 = 0.3;
        if this.phase == 3.0 { spin = 0.72; }
        this.transform.rotation_z = this.offset + this.clock * spin;

        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);
        if is_visible() { act(dt, dx, dy, far); }
        else { chase(dx, dy, far, 1.0); }

        receive_hits(player);
        Game.set("boss_hp", max(this.hp, 0.0));
        if this.hp <= 0.0 { die(); }
    }

    fn shield_count() -> f32 {
        var count: f32 = 0.0;
        for plate in World.with_tag("aegis_shield") {
            if World.exists(plate) { count += 1.0; }
        }
        return count;
    }

    fn update_phase(dt: f32) {
        let shields = shield_count();
        let share = this.hp / max(Game.get("boss_max", 1.0), 1.0);
        if shields <= 0.0 { this.phase = 3.0; }
        else if shields <= 4.0 || share <= 0.56 { this.phase = 2.0; }
        else { this.phase = 1.0; }

        if this.phase != this.previous_phase {
            this.previous_phase = this.phase;
            this.phase_flash = 0.55;
            this.attack = 0.24;
            this.special = 0.7;
            if this.phase == 3.0 {
                Game.set("aegis_core_exposed", 1.0);
                Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.75));
            }
            Effects.burst(this.entity);
            Audio.play("audio/boss.wav", 0.6);
        }
        if this.phase_flash > 0.0 {
            this.phase_flash -= dt;
            this.sprite.tint.r = 1.0;
            this.sprite.tint.g = 1.0;
            this.sprite.tint.b = 1.0;
        } else { tint(); }
    }

    fn receive_hits(player: Entity) {
        for hit in Physics.sensor_entered() {
            if hit == player {
                Game.set("player_damage_taken", max(Game.get("player_damage_taken", 0.0), 2.4));
            } else if World.exists(hit) && World.has_tag(hit, "player_damage") {
                var damage: f32 = World.property_number(hit, "damage", 0.0);
                damage = taken(hit, damage);
                this.hp -= damage;
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
    }

    // Sensor events for the plate and hull can be produced in the same physics
    // step. The plate consumes ordinary projectiles immediately, but the hull
    // also validates the projectile's actual incoming lane so script update
    // order cannot leak damage through a surviving plate.
    fn taken(hit: Entity, damage: f32) -> f32 {
        if shield_count() <= 0.0 { return damage; }

        var nx = World.property_number(hit, "dir_x", 0.0);
        var ny = World.property_number(hit, "dir_y", 0.0);
        var length = sqrt(nx * nx + ny * ny);

        // Some player-damage effects are not Bullet instances. Their current
        // position still tells us which side of the hull they approached from.
        if length <= 0.001 {
            nx = this.transform.position.x - hit.transform.position.x;
            ny = this.transform.position.y - hit.transform.position.y;
            length = sqrt(nx * nx + ny * ny);
        }
        if length <= 0.001 {
            // An undirected hit at the exact core cannot bypass intact armour.
            return 0.0;
        }
        nx /= length;
        ny /= length;

        // Walk backwards along the projectile's travel direction to the shield
        // ring and test that crossing point against the surviving plates.
        let px = this.transform.position.x - nx * 1.55;
        let py = this.transform.position.y - ny * 1.55;
        for plate in World.with_tag("aegis_shield") {
            if !World.exists(plate) { continue; }
            let sx = plate.transform.position.x - px;
            let sy = plate.transform.position.y - py;
            if sx * sx + sy * sy <= 0.30 { return 0.0; }
        }
        return damage;
    }

    fn chase(dx: f32, dy: f32, far: f32, scale: f32) {
        if far > 0.001 {
            Physics.set_velocity(this.entity, dx / far * 0.72 * scale,
                                 dy / far * 0.72 * scale);
        }
    }

    fn orbit(dx: f32, dy: f32, far: f32, want: f32, tangent: f32) {
        if far <= 0.001 { return; }
        var radial: f32 = 0.0;
        if far > want + 0.45 { radial = 1.0; }
        if far < want - 0.45 { radial = -0.55; }
        let nx = dx / far;
        let ny = dy / far;
        Physics.set_velocity(this.entity,
            (nx * radial - ny * tangent) * 0.72,
            (ny * radial + nx * tangent) * 0.72);
    }

    fn fire_fan(nx: f32, ny: f32, count: f32, velocity: f32, spread: f32) {
        let base = atan2(ny, nx);
        let half = (count - 1.0) * 0.5;
        var slot: f32 = 0.0;
        while slot < count {
            fire_at(base + (slot - half) * spread, velocity, 1.0);
            slot += 1.0;
        }
        Audio.play("audio/boss.wav", 0.38);
    }

    fn fire_ring(count: f32, velocity: f32, gaps: f32) {
        var slot: f32 = 0.0;
        let gap = (this.clock * 1.4) % count;
        while slot < count {
            let distance = abs(slot - gap);
            if gaps <= 0.0 || (distance > gaps && distance < count - gaps) {
                fire_at(slot / count * 6.2831853 - this.clock * 0.65, velocity, 1.0);
            }
            slot += 1.0;
        }
        Audio.play("audio/boss.wav", 0.4);
    }

    fn fire_at(angle: f32, velocity: f32, damage: f32) {
        let bolt = World.spawn(this.shot);
        bolt.transform.position.x = this.transform.position.x + cos(angle) * 0.65;
        bolt.transform.position.y = this.transform.position.y + sin(angle) * 0.65;
        World.set_property(bolt, "dir_x", cos(angle));
        World.set_property(bolt, "dir_y", sin(angle));
        World.set_property(bolt, "speed", velocity);
        World.set_property(bolt, "damage", damage);
    }

    fn fire_laser(angle: f32) {
        let beam = World.spawn(this.desperation_laser);
        beam.transform.position.x = this.transform.position.x;
        beam.transform.position.y = this.transform.position.y;
        World.set_property(beam, "angle", angle);
    }

    fn laser_burst() {
        let first = Random.range(0.0, 6.2831853);
        fire_laser(first);
        fire_laser(first + Random.range(1.15, 2.15));
        if Random.range(0.0, 1.0) > 0.45 {
            fire_laser(first + Random.range(3.4, 5.1));
        }
    }

    fn visible_half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 * aspect; }
        return this.view_size * 0.5;
    }

    fn visible_half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5; }
        return this.view_size * 0.5 / aspect;
    }

    fn is_visible() -> bool {
        let half_x = visible_half_x();
        let half_y = visible_half_y();
        let radius = max(abs(this.transform.scale.x), abs(this.transform.scale.y)) * 0.5;
        return this.transform.position.x + radius >= -half_x &&
               this.transform.position.x - radius <= half_x &&
               this.transform.position.y + radius >= -half_y &&
               this.transform.position.y - radius <= half_y;
    }

    fn act(dt: f32, dx: f32, dy: f32, far: f32) {
        if this.phase == 1.0 { orbit(dx, dy, far, 4.15, 0.27); }
        else if this.phase == 2.0 { orbit(dx, dy, far, 3.7, 0.39); }
        else { orbit(dx, dy, far, 3.25, 0.58); }

        this.attack -= dt;
        this.special -= dt;

        if this.attack <= 0.0 {
            if this.phase == 1.0 {
                fire_ring(8.0, 3.9, 1.0);
                this.attack = 1.45;
            } else if this.phase == 2.0 {
                if (this.clock % 2.0) < 1.0 { fire_ring(10.0, 4.4, 1.0); }
                else { fire_fan(dx, dy, 5.0, 5.0, 0.16); }
                this.attack = 0.92;
            } else {
                fire_ring(14.0, 5.0, 1.0);
                fire_fan(dx, dy, 5.0, 5.8, 0.13);
                this.attack = 0.72;
            }
        }

        if this.special <= 0.0 {
            if this.phase == 1.0 {
                fire_fan(dx, dy, 5.0, 4.5, 0.18);
                this.special = 3.1;
            } else if this.phase == 2.0 {
                fire_ring(12.0, 4.7, 0.0);
                fire_fan(dx, dy, 7.0, 5.0, 0.14);
                this.special = 2.35;
            } else {
                laser_burst();
                this.special = Random.range(1.55, 2.15);
            }
        }
    }

    fn build_shield_ring() {
        if this.ring_built > 0.0 { return; }
        this.ring_built = 1.0;
        var slot: f32 = 0.0;
        while slot < 8.0 {
            let plate = World.spawn(this.shield_segment);
            World.set_property(plate, "angle", slot / 8.0 * 6.2831853);
            World.set_property(plate, "radius", 1.55);
            World.set_property(plate, "spin", 0.55);
            World.set_property(plate, "health", 7.0);
            slot += 1.0;
        }
    }

    fn die() {
        Game.set("aegis_core_exposed", 0.0);
        if this.death_burst_damage > 0.0 {
            let wave = World.spawn(this.death_burst);
            wave.transform.position.x = this.transform.position.x;
            wave.transform.position.y = this.transform.position.y;
            World.set_property(wave, "damage", this.death_burst_damage);
        }
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.9));
        Audio.play("audio/kill.wav", 0.6);
        Game.set("kills", Game.get("kills", 0.0) + 1.0);
        Game.set("score", Game.get("score", 0.0) + 920.0);
        Game.set("boss_hp", 0.0);
        Game.set("boss_max", 0.0);
        var made: f32 = 0.0;
        while made < 8.0 {
            let angle = made / 8.0 * 6.2831853;
            let drop = World.spawn(this.core);
            drop.transform.position.x = this.transform.position.x + cos(angle) * 1.2;
            drop.transform.position.y = this.transform.position.y + sin(angle) * 1.2;
            World.set_property(drop, "worth", 5.0);
            made += 1.0;
        }
        let roll = World.spawn(this.drop_roll);
        roll.transform.position.x = this.transform.position.x;
        roll.transform.position.y = this.transform.position.y;
        World.set_property(roll, "boss", 1.0);
        World.despawn(this.entity);
    }
}
