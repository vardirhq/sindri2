#menu {
    width: 1040px;
    height: 700px;
    padding: 44px;
    direction: column;
    gap: 24px;
    justify-content: center;
    align-items: center;
    background: #0b1220;
    border-color: #263449;
    border-width: 2px;
    border-radius: 28px;
}

sindri.ui.text {
    text-align: center;
}

.topbar {
    width: 100%;
    height: 52px;
    direction: row;
    justify-content: space-between;
    align-items: center;
}

.eyebrow {
    width: 420px;
    height: 18px;
    color: #5eead4;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2px;
}

.viewport-badge {
    width: 150px;
    height: 38px;
    direction: row;
    justify-content: center;
    align-items: center;
    background: #122033;
    border-color: #334155;
    border-width: 1px;
    border-radius: 19px;
}

.badge-label {
    width: 140px;
    height: 14px;
    color: #a7f3d0;
    font-size: 12px;
    line-height: 14px;
    font-weight: 700;
    letter-spacing: 1px;
}

.hero {
    width: 100%;
    height: 286px;
    direction: row;
    gap: 30px;
    justify-content: space-between;
    align-items: center;
}

.hero-copy {
    width: 58%;
    height: 246px;
    direction: column;
    gap: 18px;
    justify-content: center;
    align-items: start;
}

.title {
    width: 100%;
    height: 98px;
    color: #f8fafc;
    font-size: 42px;
    line-height: 48px;
    font-weight: 700;
    letter-spacing: 1px;
}

.subtitle {
    width: 100%;
    height: 78px;
    color: #94a3b8;
    font-size: 16px;
    line-height: 23px;
    letter-spacing: 1px;
    text-wrap: word;
}

.proof-card {
    width: 34%;
    height: 230px;
    padding: 22px;
    direction: column;
    gap: 16px;
    justify-content: center;
    align-items: center;
    background: #111c2d;
    border-color: #3b4a63;
    border-width: 1px;
    border-radius: 22px;
}

.proof-kicker {
    width: 100%;
    height: 16px;
    color: #c4b5fd;
    font-size: 14px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 2px;
}

.proof-title {
    width: 100%;
    height: 26px;
    color: #f8fafc;
    font-size: 22px;
    line-height: 26px;
    font-weight: 700;
    letter-spacing: 1px;
}

.proof-body {
    width: 100%;
    height: 36px;
    color: #94a3b8;
    font-size: 13px;
    line-height: 18px;
    letter-spacing: 1px;
}

.actions {
    width: 100%;
    height: 62px;
    direction: row;
    gap: 16px;
    justify-content: start;
    align-items: center;
}

.menu-button {
    width: 220px;
    height: 54px;
    border-width: 1px;
    border-radius: 14px;
}

.primary {
    background: #5eead4;
    border-color: #99f6e4;
}

.secondary {
    background: #8b5cf6;
    border-color: #a78bfa;
}

.button-label {
    width: 200px;
    height: 20px;
    color: #f8fafc;
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
    letter-spacing: 1px;
}

.primary-label {
    color: #0f172a;
}

.features {
    width: 100%;
    height: 92px;
    direction: row;
    gap: 14px;
    justify-content: space-between;
    align-items: center;
}

.feature-card {
    width: 31%;
    height: 76px;
    direction: column;
    justify-content: center;
    align-items: center;
    background: #101a2a;
    border-color: #29374d;
    border-width: 1px;
    border-radius: 14px;
}

.feature-start {
    border-color: #2dd4bf;
}

.feature-center {
    border-color: #60a5fa;
}

.feature-end {
    border-color: #a78bfa;
}

.feature-label {
    width: 120px;
    height: 16px;
    color: #dbeafe;
    font-size: 13px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 2px;
}

@media (orientation: portrait) {
    #menu {
        width: 94vw;
        height: 120vw;
        padding: 4vw;
        gap: 2.5vw;
        justify-content: start;
        align-items: center;
        border-radius: 5vw;
    }

    .topbar {
        width: 92%;
        height: 8vw;
        justify-content: space-between;
        align-items: center;
    }

    .eyebrow {
        width: 58%;
        height: 4vw;
        font-size: 3.2vw;
        line-height: 4vw;
        letter-spacing: 0.25vw;
    }

    .viewport-badge {
        width: 26vw;
        height: 8vw;
    }

    .badge-label {
        width: 24vw;
        height: 3.5vw;
        font-size: 2.8vw;
        line-height: 3.5vw;
    }

    .hero {
        width: 100%;
        height: 44vw;
        direction: column;
        gap: 2.5vw;
        justify-content: start;
        align-items: center;
    }

    .hero-copy {
        width: 100%;
        height: 19vw;
        gap: 2vw;
        justify-content: start;
        align-items: center;
    }

    .title {
        width: 100%;
        height: 9vw;
        font-size: 4.8vw;
        line-height: 5.8vw;
    }

    .subtitle {
        width: 88%;
        height: 8vw;
        font-size: 2.5vw;
        line-height: 3.5vw;
    }

    .proof-card {
        width: 96%;
        height: 22.5vw;
        padding: 2.5vw;
        gap: 1.5vw;
        justify-content: center;
        align-items: center;
        border-radius: 4vw;
    }

    .proof-kicker {
        width: 100%;
        height: 3vw;
        font-size: 2.6vw;
        line-height: 3vw;
    }

    .proof-title {
        width: 100%;
        height: 5.5vw;
        font-size: 4.2vw;
        line-height: 5.2vw;
    }

    .proof-body {
        width: 100%;
        height: 4.5vw;
        font-size: 2.4vw;
        line-height: 3.5vw;
    }

    .actions {
        width: 100%;
        height: 22vw;
        direction: column;
        gap: 3vw;
        justify-content: start;
        align-items: center;
    }

    .menu-button {
        width: 96%;
        height: 9.5vw;
        border-radius: 3vw;
    }

    .button-label {
        width: 45vw;
        height: 4vw;
        font-size: 3.4vw;
        line-height: 4vw;
    }

    .features {
        width: 100%;
        height: 30vw;
        direction: column;
        gap: 2.25vw;
        justify-content: start;
        align-items: center;
    }

    .feature-card {
        width: 96%;
        height: 8.5vw;
        padding: 3vw;
        justify-content: center;
        border-radius: 3vw;
    }

    .feature-start {
        align-items: start;
    }

    .feature-center {
        align-items: center;
    }

    .feature-end {
        align-items: end;
    }

    .feature-label {
        width: 22vw;
        height: 4vw;
        font-size: 3vw;
        line-height: 4vw;
        letter-spacing: 0.25vw;
    }
}
