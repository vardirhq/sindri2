// Visual fill for the native slider POC. The slider owns interaction and value;
// this ordinary UI child owns presentation, so Weave remains free to style it.
script SliderFill {
    @export
    let channel: f32 = 0.0;

    var full_height: f32 = 1.0;

    fn start() {
        this.full_height = this.transform.scale.y;
    }

    fn update(dt: f32) {
        let slider = World.find("Red Slider");
        if this.channel == 1.0 {
            slider = World.find("Green Slider");
        }
        if this.channel == 2.0 {
            slider = World.find("Blue Slider");
        }
        if slider == null {
            return;
        }

        let amount = Ui.slider_value(slider) / 255.0;
        this.transform.scale.y = this.full_height * amount;
        this.transform.position.y = -this.full_height * (1.0 - amount) * 0.5;
    }
}
