script SliderDemo {
    fn update(dt: f32) {
        let red = World.find("red-slider");
        let green = World.find("green-slider");
        let blue = World.find("blue-slider");

        Ui.set_number(World.find("red-value"), Ui.slider_value(red));
        Ui.set_number(World.find("green-value"), Ui.slider_value(green));
        Ui.set_number(World.find("blue-value"), Ui.slider_value(blue));
    }
}
