// One player: walks with the left stick, sprints with the left bumper, picks a
// skin and readies up in the lobby, and charges a kick with the right bumper,
// aimed with the right stick.
//
// A player is made by the match when a pad joins, and told which slot it is.
// Odd slots play for Blue, who defend the left goal; even slots for Red.
//
// A bot is a player with no pad: the match makes one on slot 11 or 12 when
// Select is pressed in the lobby, and it steers itself (see `think`).
script Player {
    @export let slot: f32 = 1.0;
    @export let bot: bool = false;
    // How long a bot takes to notice what changed, and how far off it aims.
    @export let reaction: f32 = 0.22;
    @export let aim_noise: f32 = 0.7;
    @export let arrow: Prefab;
    @export let speed: f32 = 10.0;
    @export let sprint_speed: f32 = 1.45;
    @export let sprint_animation_speed: f32 = 4.0;
    @export let kick_speed: f32 = 22.0;
    @export let charged_kick: f32 = 34.0;
    @export let boost_kick: f32 = 36.0;
    @export let charged_boost_kick: f32 = 48.0;
    @export let charge_time: f32 = 0.85;
    // How big a player is drawn: an unready player stands tall in the lobby,
    // and the Enlarger makes one bigger for a while.
    @export let normal: f32 = 3.2;
    @export let big: f32 = 1.75;
    @export let grown: f32 = 1.6;
    @export let power_time: f32 = 20.0;
    @export let burn_time: f32 = 5.0;

    var team: f32 = 1.0;
    var skin: f32 = 0.0;
    var ready: bool = false;
    var size: f32 = 1.75;
    var grow_left: f32 = 0.0;
    var boost_left: f32 = 0.0;
    var burn_left: f32 = 0.0;
    var burn_turn: f32 = 0.0;
    var burn_x: f32 = 0.0;
    var burn_y: f32 = 0.0;
    var fire_clock: f32 = 0.0;
    var vx: f32 = 0.0;
    var vy: f32 = 0.0;
    var face_right: bool = true;
    var face_down: bool = true;
    var moving: bool = false;
    var sprinting: bool = false;
    var charge: f32 = 0.0;
    var charge_fx: f32 = 0.0;
    var referee: Entity = null;
    var ball: Entity = null;
    // A bot's plan: where it is heading, and a kick it has decided on.
    var plan_left: f32 = 0.0;
    var want_x: f32 = 0.0;
    var want_y: f32 = 0.0;
    var kick_left: f32 = -1.0;
    var aim_x: f32 = 0.0;
    var aim_y: f32 = 0.0;
    var kick_now: bool = false;
    var seen_bx: f32 = 0.0;
    var seen_by: f32 = 0.0;
    var ball_vx: f32 = 0.0;
    var ball_vy: f32 = 0.0;

    fn start() {
        if this.slot % 2.0 == 1.0 {
            this.team = 1.0;
            this.skin = 0.0;
        } else {
            this.team = 2.0;
            this.skin = 1.0;
            this.face_right = false;
        }
        this.referee = World.find("Match");
        this.ball = World.find("Ball");
        // A child, so it rides over the player's head, grows with them, and
        // goes when they do.
        let marker = World.spawn_child(this.arrow, this.entity);
        Animation.play(marker, marker_clip());
        if this.bot {
            this.ready = true;
            this.size = 1.0;
        }
        show();
    }

    fn update(dt: f32) {
        let phase = Game.get("phase", 0.0);
        take_signals();
        if this.bot {
            think(dt, phase);
        } else {
            lobby(phase);
        }
        if this.ready {
            World.send_signal(this.referee, "ready", 1.0);
        }
        move(dt, phase);
        try_kick(dt, phase);
        grow(dt);
        burn(dt);
        show();
    }

    fn take_signals() {
        if World.take_signal("grow") > 0.0 {
            this.grow_left = this.power_time;
        }
        if World.take_signal("boost") > 0.0 {
            this.boost_left = this.power_time;
        }
        if World.take_signal("burn") > 0.0 && this.burn_left <= 0.0 {
            this.burn_left = this.burn_time;
            this.burn_turn = 0.0;
            Audio.play("audio/hit.wav", 0.8);
        }
    }

    // Before kickoff a player picks a skin with the d-pad and readies with
    // North (Y on most pads). Readying again takes it back until the match
    // starts; a player joining mid-match readies straight into play.
    fn lobby(phase: f32) {
        if !this.ready && (Gamepad.just_pressed(this.slot, "dpad_up") || Gamepad.just_pressed(this.slot, "dpad_down")) {
            this.skin = 1.0 - this.skin;
        }
        if Gamepad.just_pressed(this.slot, "north") {
            if !this.ready {
                this.ready = true;
                Audio.play("audio/run.wav", 0.6);
            } else if phase < 2.0 {
                this.ready = false;
            }
        }
    }

    fn move(dt: f32, phase: f32) {
        var tx: f32 = 0.0;
        var ty: f32 = 0.0;
        this.sprinting = false;
        if this.burn_left > 0.0 {
            tx = this.burn_x * this.speed;
            ty = this.burn_y * this.speed;
        } else if this.bot && phase >= 2.0 {
            tx = this.want_x * this.speed;
            ty = this.want_y * this.speed;
        } else if this.ready && phase >= 2.0 {
            var x: f32 = Gamepad.axis(this.slot, "left_x");
            var y: f32 = Gamepad.axis(this.slot, "left_y");
            if Gamepad.is_down(this.slot, "dpad_left") { x = -1.0; }
            if Gamepad.is_down(this.slot, "dpad_right") { x = 1.0; }
            if Gamepad.is_down(this.slot, "dpad_up") { y = -1.0; }
            if Gamepad.is_down(this.slot, "dpad_down") { y = 1.0; }
            var pace: f32 = this.speed;
            if Gamepad.is_down(this.slot, "left_bumper") && (abs(x) > 0.1 || abs(y) > 0.1) {
                pace = this.speed * this.sprint_speed;
                this.sprinting = true;
            }
            // The pad measures down as positive; the pitch measures up.
            tx = x * pace;
            ty = -y * pace;
        }
        tx += Game.get("wind", 0.0) * 0.4;
        // Eased towards, as the old forces and drag did, so a player leans
        // into a turn rather than snapping round.
        let ease = min(1.0, dt * 12.0);
        this.vx += (tx - this.vx) * ease;
        this.vy += (ty - this.vy) * ease;
        Physics.set_velocity(this.entity, this.vx, this.vy);

        this.moving = abs(this.vx) > 1.0 || abs(this.vy) > 1.0;
        if this.vx > 1.0 { this.face_right = true; }
        if this.vx < -1.0 { this.face_right = false; }
        if this.vy < -1.0 { this.face_down = true; }
        if this.vy > 1.0 { this.face_down = false; }

        // Kept on the grass, and drawn in front of whoever is further up it.
        this.transform.position.x = max(-15.8, min(15.8, this.transform.position.x));
        this.transform.position.y = max(-6.4, min(7.0, this.transform.position.y));
        this.transform.position.z = 1.0 - this.transform.position.y * 0.01;
    }

    // Hold the right bumper to charge, then release to kick where the right
    // stick points. A quick tap remains the ordinary kick. Bots keep their
    // existing immediate shot timing rather than pretending to hold a pad.
    fn try_kick(dt: f32, phase: f32) {
        if phase < 2.0 || this.burn_left > 0.0 || Game.get("holder", 0.0) != this.slot {
            this.charge = 0.0;
            this.charge_fx = 0.0;
            return;
        }
        var ax: f32 = 0.0;
        var ay: f32 = 0.0;
        var shot_charge: f32 = 0.0;
        if this.bot {
            if !this.kick_now {
                return;
            }
            this.kick_now = false;
            ax = this.aim_x;
            ay = this.aim_y;
        } else {
            if Gamepad.is_down(this.slot, "right_bumper") {
                this.charge = min(1.0, this.charge + dt / this.charge_time);
                this.charge_fx -= dt;
                if this.charge > 0.12 && this.charge_fx <= 0.0 {
                    this.charge_fx = 0.11 - this.charge * 0.045;
                    Effects.burst(this.ball);
                }
                return;
            }
            if !Gamepad.just_released(this.slot, "right_bumper") {
                return;
            }
            shot_charge = this.charge;
            this.charge = 0.0;
            this.charge_fx = 0.0;
            ax = Gamepad.axis(this.slot, "right_x");
            ay = -Gamepad.axis(this.slot, "right_y");
        }
        let length = sqrt(ax * ax + ay * ay);
        if length < 0.3 {
            ax = -1.0;
            if this.face_right { ax = 1.0; }
            ay = 0.0;
        } else {
            ax = ax / length;
            ay = ay / length;
        }
        var force = this.kick_speed + (this.charged_kick - this.kick_speed) * shot_charge;
        if this.boost_left > 0.0 {
            force = this.boost_kick + (this.charged_boost_kick - this.boost_kick) * shot_charge;
        }
        World.send_signal(this.ball, "kick_x", ax * force);
        World.send_signal(this.ball, "kick_y", ay * force);
        World.send_signal(this.ball, "kick", 1.0);
        Audio.play("audio/hit.wav", min(1.0, 0.72 + shot_charge * 0.28));
    }

    fn grow(dt: f32) {
        this.grow_left = max(0.0, this.grow_left - dt);
        this.boost_left = max(0.0, this.boost_left - dt);
        var target: f32 = 1.0;
        if !this.ready {
            target = this.big;
        } else if this.grow_left > 0.0 {
            target = this.grown;
        }
        this.size += (target - this.size) * min(1.0, dt * 3.0);
        this.transform.scale.x = this.normal * this.size;
        this.transform.scale.y = this.normal * this.size;
    }

    // On fire: running wild in a new direction every second, trailing flame,
    // until it burns out.
    fn burn(dt: f32) {
        if this.burn_left <= 0.0 {
            return;
        }
        this.burn_left -= dt;
        this.burn_turn -= dt;
        if this.burn_turn <= 0.0 {
            this.burn_turn = 1.0;
            this.burn_x = Random.range(-1.5, 1.5);
            this.burn_y = Random.range(-1.5, 1.5);
        }
        this.fire_clock -= dt;
        if this.fire_clock <= 0.0 {
            this.fire_clock = 0.07;
            Effects.burst(this.entity);
        }
    }

    fn show() {
        let clip = clip_name();
        if Animation.clip(this.entity) != clip {
            Animation.play(this.entity, clip);
        }
        var animation_speed: f32 = 1.0;
        if this.sprinting && this.moving {
            animation_speed = this.sprint_animation_speed;
        }
        Animation.set_speed(this.entity, animation_speed);
    }

    fn clip_name() -> String {
        if this.skin == 0.0 {
            if this.moving {
                if this.face_right {
                    if this.face_down { return "ginger-walk-rd"; }
                    return "ginger-walk-ru";
                }
                if this.face_down { return "ginger-walk-ld"; }
                return "ginger-walk-lu";
            }
            if this.face_right {
                if this.face_down { return "ginger-idle-rd"; }
                return "ginger-idle-ru";
            }
            if this.face_down { return "ginger-idle-ld"; }
            return "ginger-idle-lu";
        }
        if this.moving {
            if this.face_right {
                if this.face_down { return "yellow-walk-rd"; }
                return "yellow-walk-ru";
            }
            if this.face_down { return "yellow-walk-ld"; }
            return "yellow-walk-lu";
        }
        if this.face_right {
            if this.face_down { return "yellow-idle-rd"; }
            return "yellow-idle-ru";
        }
        if this.face_down { return "yellow-idle-ld"; }
        return "yellow-idle-lu";
    }

    fn marker_clip() -> String {
        if this.slot == 1.0 { return "p1"; }
        if this.slot == 2.0 { return "p2"; }
        if this.slot == 3.0 { return "p3"; }
        if this.slot == 11.0 { return "p1"; }
        if this.slot == 12.0 { return "p2"; }
        return "p4";
    }

    // ---- The bot ----------------------------------------------------------
    //
    // A bot looks at the pitch a few times a second, not every frame, and
    // acts on what it saw a moment ago, so it can be wrong-footed like a
    // person. Each look it picks one of four things to do: attack with the
    // ball, support a teammate who has it, defend against whoever has it, or
    // go for a loose ball it can reach first. A defender stands between the
    // ball and its goal and closes in, rather than chasing.
    fn think(dt: f32, phase: f32) {
        if this.kick_left >= 0.0 {
            this.kick_left -= dt;
            if this.kick_left < 0.0 {
                this.kick_now = true;
            }
        }
        this.plan_left -= dt;
        if phase < 2.0 || this.plan_left > 0.0 {
            return;
        }
        let look = this.reaction * Random.range(0.7, 1.3);
        this.plan_left = look;
        let ball = this.ball;
        let bx = ball.transform.position.x;
        let by = ball.transform.position.y;
        this.ball_vx = (bx - this.seen_bx) / look;
        this.ball_vy = (by - this.seen_by) / look;
        this.seen_bx = bx;
        this.seen_by = by;

        let holder = Game.get("holder", 0.0);
        if holder == this.slot {
            attack(bx, by);
        } else if holder > 0.0 && holder % 2.0 == this.slot % 2.0 {
            support(bx, by);
        } else if holder > 0.0 {
            defend(bx, by, true);
        } else if first_to(bx, by) {
            // Run to where the ball is going, from behind it.
            head_to(bx + this.ball_vx * 0.4 - attack_way() * 0.3, by + this.ball_vy * 0.4, 1.0);
        } else {
            defend(bx, by, false);
        }
    }

    // Towards the goal, round anyone in the way, and a shot once close enough
    // or crowded: at the side of the goal the nearest opponent is not.
    fn attack(bx: f32, by: f32) {
        let way = attack_way();
        let goal_x = 14.9 * way;
        let near = nearest_opponent(bx, by);
        var ox: f32 = 100.0;
        var oy: f32 = 100.0;
        if near != null {
            ox = near.transform.position.x;
            oy = feet(near);
        }
        let ahead = (ox - bx) * way;
        let pressed = abs(ox - bx) < 2.0 && abs(oy - by) < 2.0;
        let range = abs(goal_x - bx);
        if this.kick_left < 0.0 && (range < 9.0 || (pressed && range < 15.0 && ahead > 0.0)) {
            var side: f32 = 1.4;
            if oy > 0.0 { side = -1.4; }
            let aim_y = side + Random.range(-this.aim_noise, this.aim_noise);
            let dx = goal_x + way - bx;
            let dy = aim_y - by;
            let length = sqrt(dx * dx + dy * dy);
            this.aim_x = dx / length;
            this.aim_y = dy / length;
            this.kick_left = Random.range(0.05, 0.2);
        }
        var dy: f32 = (0.0 - by) * 0.15;
        if ahead > 0.0 && ahead < 4.5 && abs(oy - by) < 2.5 {
            // Someone in front: go round on the side with more room.
            dy = 0.9;
            if oy > by || by > 4.5 { dy = -0.9; }
            if by < -4.5 { dy = 0.9; }
        }
        steer(way, dy, 1.0);
    }

    // A teammate has it: get ahead of the ball on the other side of the
    // pitch, ready for it.
    fn support(bx: f32, by: f32) {
        head_to(bx + attack_way() * 5.0, 0.0 - by * 0.6, 0.9);
    }

    // Goal-side of the ball, a third of the way back to goal, and in to
    // tackle once close. `pressing` is whether someone has it.
    fn defend(bx: f32, by: f32, pressing: bool) {
        let own_x = -14.9 * attack_way();
        let x = this.transform.position.x;
        let y = feet(this.entity);
        let dx = bx - x;
        let dy = by - y;
        let goal_side = (x - bx) * attack_way() < 0.0;
        if pressing && goal_side && sqrt(dx * dx + dy * dy) < 3.5 {
            head_to(bx, by, 1.0);
            return;
        }
        head_to(bx + (own_x - bx) * 0.35, by * 0.65, 1.0);
    }

    // Whether this bot gets to a loose ball before anyone on the other team.
    fn first_to(bx: f32, by: f32) -> bool {
        let mine = distance(this.entity, bx, by);
        let near = nearest_opponent(bx, by);
        if near == null {
            return true;
        }
        return mine < distance(near, bx, by) + 1.5;
    }

    fn nearest_opponent(bx: f32, by: f32) -> Entity {
        var best: Entity = null;
        var best_distance: f32 = 1000.0;
        for someone in World.with_tag("player") {
            let slot = World.property_number(someone, "slot", 0.0);
            if slot % 2.0 != this.slot % 2.0 {
                let d = distance(someone, bx, by);
                if d < best_distance {
                    best_distance = d;
                    best = someone;
                }
            }
        }
        return best;
    }

    fn head_to(x: f32, y: f32, pace: f32) {
        let dx = x - this.transform.position.x;
        let dy = y - feet(this.entity);
        let length = sqrt(dx * dx + dy * dy);
        if length < 0.2 {
            steer(0.0, 0.0, 0.0);
            return;
        }
        // Slowing into place rather than overshooting it.
        steer(dx, dy, pace * min(1.0, length / 1.5));
    }

    fn steer(dx: f32, dy: f32, pace: f32) {
        let length = sqrt(dx * dx + dy * dy);
        if length < 0.001 {
            this.want_x = 0.0;
            this.want_y = 0.0;
            return;
        }
        this.want_x = dx / length * pace;
        this.want_y = dy / length * pace;
    }

    fn distance(someone: Entity, x: f32, y: f32) -> f32 {
        let dx = x - someone.transform.position.x;
        let dy = y - feet(someone);
        return sqrt(dx * dx + dy * dy);
    }

    // Where a player's feet are, which is where they take the ball.
    fn feet(someone: Entity) -> f32 {
        return someone.transform.position.y - 1.1 * someone.transform.scale.x / 3.2;
    }

    fn attack_way() -> f32 {
        if this.team == 1.0 {
            return 1.0;
        }
        return -1.0;
    }
}