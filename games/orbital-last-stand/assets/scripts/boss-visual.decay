// Independent boss ornament layer. Gameplay stays on the boss root; these
// children make boss phases readable through motion, sweep and scale.
script BossVisual {
    @export let kind: f32 = 0.0;
    @export let phase_offset: f32 = 0.0;

    var boss: Entity = null;
    var clock: f32 = 0.0;

    fn start() {
        this.boss = World.find("Warden");
    }

    fn update(dt: f32) {
        let boss = this.boss;
        if boss == null || !World.exists(boss) { return; }
        if Game.get("run_state", 0.0) == 1.0 { this.clock += dt; }

        this.transform.position.x = boss.transform.position.x;
        this.transform.position.y = boss.transform.position.y;

        let max_hp = max(1.0, Game.get("boss_max", 1.0));
        let hp_share = max(0.0, Game.get("boss_hp", max_hp)) / max_hp;
        var phase: f32 = 1.0;
        if hp_share <= 0.30 { phase = 3.0; }
        else if hp_share <= 0.65 { phase = 2.0; }
        let fury = (phase - 1.0) * 0.5;
        let pulse = 0.5 + 0.5 * sin(this.clock * (4.5 + phase * 1.7) + this.phase_offset);

        if this.kind == 0.0 {
            let size = 1.28 + pulse * 0.10 + fury * 0.14;
            this.transform.scale.x = size;
            this.transform.scale.y = size;
            this.transform.rotation_z = this.clock * (0.55 + phase * 0.55) + this.phase_offset;
            this.shape.dashes = 6.0 + phase * 2.0;
            this.shape.dash_duty = 0.32 + pulse * 0.18;
            this.shape.sweep_start = this.clock * (0.09 + phase * 0.04);
            this.shape.stroke.a = 0.30 + pulse * 0.28 + fury * 0.18;
            this.shape.stroke_width = 0.045 + phase * 0.012;
        } else if this.kind == 1.0 {
            let size = 0.72 + pulse * 0.13 + fury * 0.08;
            this.transform.scale.x = size;
            this.transform.scale.y = size;
            this.transform.rotation_z = -this.clock * (1.1 + phase * 0.75) + this.phase_offset;
            this.shape.stroke.a = 0.50 + pulse * 0.35;
            this.shape.fill.a = 0.025 + pulse * 0.075 + fury * 0.06;
            this.shape.stroke_width = 0.055 + pulse * 0.025;
        } else {
            let size = 0.19 + pulse * 0.10 + fury * 0.06;
            this.transform.scale.x = size;
            this.transform.scale.y = size;
            this.transform.rotation_z = this.clock * (2.8 + phase * 1.3);
            this.shape.fill.a = 0.50 + pulse * 0.42;
            this.shape.stroke.a = 0.68 + pulse * 0.28;
            this.shape.stroke_width = 0.06 + fury * 0.03;
        }
    }
}
