// Decorative secondary marks used by reference enemy archetypes. The parent owns
// movement and combat; these children inherit its rotation and add only the
// renderer-specific ring/arc/triangle treatment.
script EnemyMark {
    @export let mode: f32 = 0.0;

    var clock: f32 = 0.0;
    var phase: f32 = 0.0;

    fn start() {
        if this.mode == 0.0 {
            // Leech: partial arc, 1.35 PI in the reference renderer.
            this.transform.scale.x = 1.35;
            this.transform.scale.y = 1.35;
            this.shape.sweep_turns = 0.675;
            this.shape.stroke.r = 1.0;
            this.shape.stroke.g = 0.8157;
            this.shape.stroke.b = 0.9098;
            this.shape.stroke.a = 1.0;
        } else if this.mode == 1.0 {
            // Relay: three-quarter outer arc.
            this.transform.scale.x = 1.4;
            this.transform.scale.y = 1.4;
            this.shape.sweep_turns = 0.75;
            this.shape.stroke.r = 0.8471;
            this.shape.stroke.g = 1.0;
            this.shape.stroke.b = 0.9608;
            this.shape.stroke.a = 1.0;
        } else if this.mode == 2.0 {
            // Burrower: dashed full ring. The body already carries submerged
            // opacity; this preserves the reference's distinct outer marker.
            this.transform.scale.x = 1.45;
            this.transform.scale.y = 1.45;
            this.shape.sweep_turns = 1.0;
            this.shape.dashes = 9.0;
            this.shape.dash_duty = 0.45;
            this.shape.stroke.r = 1.0;
            this.shape.stroke.g = 0.8196;
            this.shape.stroke.b = 0.7373;
            this.shape.stroke.a = 0.75;
        } else if this.mode == 3.0 {
            // Phaser: pulsing outer triangle, rotated -0.2 rad locally.
            this.transform.scale.x = 1.55;
            this.transform.scale.y = 1.55;
            this.transform.rotation_z = -0.2;
            this.shape.count = 3.0;
            this.shape.stroke.r = 0.9451;
            this.shape.stroke.g = 0.8627;
            this.shape.stroke.b = 1.0;
        } else {
            // Bulwark: very faint support-radius ring. The original pulses
            // around 0.1 alpha at 4 Hz, with each enemy offset independently.
            this.phase = Random.range(0.0, 6.2831853);
            this.transform.scale.x = 8.6;
            this.transform.scale.y = 8.6;
            this.shape.sweep_turns = 1.0;
            this.shape.stroke.r = 1.0;
            this.shape.stroke.g = 0.5490;
            this.shape.stroke.b = 0.6275;
        }
    }

    fn update(dt: f32) {
        this.clock += dt;
        if this.mode == 3.0 {
            this.shape.stroke.a = 0.35 + 0.25 * sin(this.clock * 12.0);
        } else if this.mode == 4.0 {
            this.shape.stroke.a = 0.1 + 0.025 * sin(this.clock * 4.0 + this.phase);
        }
    }
}
