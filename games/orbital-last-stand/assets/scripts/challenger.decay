// The remaining tier-one bosses from the reference game.
// kind: 0 Harrower, 1 Prism, 2 Singularity.
script Challenger {
    @export let kind: f32 = 0.0;
    @export let view_size: f32 = 11.0;
    @export let shot: Prefab;
    @export let core: Prefab;
    @export let drop_roll: Prefab;
    @export let death_burst: Prefab;
    @export let hazard_damage: f32 = 0.0;

    var health: f32 = 132.0;
    var worth: f32 = 44.0;
    var touch_damage: f32 = 2.2;
    var speed: f32 = 1.15;
    var hp: f32 = 0.0;
    var phase: f32 = 1.0;
    var previous_phase: f32 = 1.0;
    var attack: f32 = 0.9;
    var special: f32 = 2.7;
    var clock: f32 = 0.0;
    var offset: f32 = 0.0;
    var telegraph: f32 = 0.0;
    var dash_time: f32 = 0.0;
    var dash_x: f32 = 0.0;
    var dash_y: f32 = 0.0;
    var phase_flash: f32 = 0.0;
    var death_burst_damage: f32 = 0.0;

    fn start() {
        configure_kind();
        let elapsed = Game.get("elapsed", 0.0);
        let scale = 1.0 + min(1.35, max(0.0, elapsed - 60.0) * 0.0025);
        this.hp = this.health * scale;
        this.offset = Random.range(0.0, 6.2831853);
        this.attack = 0.75;
        Game.set("boss_max", this.hp);
        Game.set("boss_hp", this.hp);
        Game.set("boss_kind", this.kind + 1.0);
    }

    fn configure_kind() {
        if this.kind == 0.0 {
            // Harrower: aggressive pentagonal ram.
            this.health = 132.0;
            this.worth = 44.0;
            this.touch_damage = 2.35;
            this.speed = 1.3;
            this.shape.count = 5.0;
            tint(1.0, 0.61, 0.36);
        } else if this.kind == 1.0 {
            // Prism: many-sided sniper that layers fans and refracted rings.
            this.health = 144.0;
            this.worth = 48.0;
            this.touch_damage = 2.0;
            this.speed = 0.95;
            this.shape.count = 7.0;
            tint(0.56, 0.91, 1.0);
        } else {
            // Singularity: slow, dense gravity-well spirals.
            this.health = 158.0;
            this.worth = 52.0;
            this.touch_damage = 1.9;
            this.speed = 0.82;
            this.shape.count = 12.0;
            tint(0.78, 0.49, 1.0);
        }
    }

    fn tint(r: f32, g: f32, b: f32) {
        this.shape.fill.r = r;
        this.shape.fill.g = g;
        this.shape.fill.b = b;
        this.shape.stroke.r = r;
        this.shape.stroke.g = g;
        this.shape.stroke.b = b;
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        if this.hazard_damage > 0.0 {
            this.hp -= this.hazard_damage;
            this.hazard_damage = 0.0;
            if this.hp <= 0.0 { die(); return; }
        }
        let player = World.find("Player");
        if player == null { return; }

        this.clock += dt;
        this.transform.rotation_z = this.offset + this.clock * rotation_speed();
        update_phase(dt);

        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);
        let visible = is_visible();

        // Off-screen bosses may approach, but cannot aim, wind up, or fire.
        if !visible {
            chase(dx, dy, far, 1.0);
        } else if this.kind == 0.0 {
            harrower_move(dt, dx, dy, far);
        } else if this.kind == 1.0 {
            orbit(dx, dy, far, 5.2, 0.42);
            prism_attack(dt, dx, dy, far);
        } else {
            orbit(dx, dy, far, 4.2, 0.58);
            singularity_attack(dt);
        }

        receive_hits(player);
        Game.set("boss_hp", max(this.hp, 0.0));
        if this.hp <= 0.0 { die(); }
    }

    fn rotation_speed() -> f32 {
        if this.kind == 0.0 { return 0.9; }
        if this.kind == 1.0 { return -0.55; }
        return -1.05;
    }

    fn update_phase(dt: f32) {
        let share = this.hp / max(Game.get("boss_max", 1.0), 1.0);
        if share <= 0.56 { this.phase = 2.0; } else { this.phase = 1.0; }
        if this.phase != this.previous_phase {
            this.previous_phase = this.phase;
            this.phase_flash = 0.55;
            this.attack = 0.28;
            this.special = 0.75;
            this.telegraph = 0.0;
            this.dash_time = 0.0;
            Effects.burst(this.entity);
            Audio.play("audio/boss.wav", 0.55);
        }
        if this.phase_flash > 0.0 {
            this.phase_flash -= dt;
            this.shape.stroke.r = 1.0;
            this.shape.stroke.g = 1.0;
            this.shape.stroke.b = 1.0;
        } else {
            configure_color_only();
        }
    }

    fn configure_color_only() {
        if this.kind == 0.0 { tint(1.0, 0.61, 0.36); }
        else if this.kind == 1.0 { tint(0.56, 0.91, 1.0); }
        else { tint(0.78, 0.49, 1.0); }
    }

    fn harrower_move(dt: f32, dx: f32, dy: f32, far: f32) {
        if this.telegraph > 0.0 {
            this.telegraph -= dt;
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.shape.stroke.r = 1.0;
            this.shape.stroke.g = 1.0;
            this.shape.stroke.b = 1.0;
            if this.telegraph <= 0.0 { this.dash_time = 0.42; }
        } else if this.dash_time > 0.0 {
            this.dash_time -= dt;
            Physics.set_velocity(this.entity, this.dash_x * 7.2, this.dash_y * 7.2);
            if this.dash_time <= 0.0 { fire_fan(this.dash_x, this.dash_y, 5.0, 4.3); }
        } else {
            chase(dx, dy, far, 0.72);
            this.special -= dt;
            if this.special <= 0.0 && far > 0.001 {
                this.dash_x = dx / far;
                this.dash_y = dy / far;
                this.telegraph = 0.58;
                this.special = 2.5;
                if this.phase == 2.0 {
                    this.telegraph = 0.4;
                    this.special = 1.7;
                }
            }
        }
        this.attack -= dt;
        if this.attack <= 0.0 && far > 0.001 {
            fire_fan(dx / far, dy / far, 5.0, 3.8);
            if this.phase == 2.0 { this.attack = 1.05; }
            else { this.attack = 1.7; }
        }
    }

    fn prism_attack(dt: f32, dx: f32, dy: f32, far: f32) {
        this.attack -= dt;
        this.special -= dt;
        if this.attack <= 0.0 && far > 0.001 {
            if this.phase == 2.0 { fire_fan(dx / far, dy / far, 9.0, 4.7); }
            else { fire_fan(dx / far, dy / far, 7.0, 4.1); }
            if this.phase == 2.0 { this.attack = 0.9; }
            else { this.attack = 1.32; }
        }
        if this.special <= 0.0 {
            fire_ring(10.0, 3.2, 2.0);
            if this.phase == 2.0 { this.special = 2.55; }
            else { this.special = 3.7; }
        }
    }

    fn singularity_attack(dt: f32) {
        this.attack -= dt;
        if this.attack > 0.0 { return; }
        if this.phase == 2.0 {
            fire_ring(16.0, 3.2, 0.0);
            this.attack = 0.72;
        } else {
            fire_ring(12.0, 2.65, 0.0);
            this.attack = 1.05;
        }
    }

    fn chase(dx: f32, dy: f32, far: f32, scale: f32) {
        if far > 0.001 {
            Physics.set_velocity(this.entity, dx / far * this.speed * scale,
                                 dy / far * this.speed * scale);
        }
    }

    fn orbit(dx: f32, dy: f32, far: f32, want: f32, tangent: f32) {
        if far <= 0.001 { return; }
        var radial: f32 = 0.0;
        if far > want + 0.45 { radial = 1.0; }
        if far < want - 0.45 { radial = -0.55; }
        let nx = dx / far;
        let ny = dy / far;
        Physics.set_velocity(this.entity,
            (nx * radial - ny * tangent) * this.speed,
            (ny * radial + nx * tangent) * this.speed);
    }

    fn fire_fan(nx: f32, ny: f32, count: f32, velocity: f32) {
        let base = atan2(ny, nx);
        let half = (count - 1.0) * 0.5;
        var slot: f32 = 0.0;
        while slot < count {
            let angle = base + (slot - half) * 0.18;
            fire_at(this.transform.position.x, this.transform.position.y, angle, velocity, 1.0);
            slot += 1.0;
        }
        Audio.play("audio/boss.wav", 0.38);
    }

    fn fire_ring(count: f32, velocity: f32, gaps: f32) {
        var slot: f32 = 0.0;
        let gap = (this.clock * 1.4) % count;
        while slot < count {
            let distance = abs(slot - gap);
            if gaps <= 0.0 || (distance > gaps && distance < count - gaps) {
                let angle = slot / count * 6.2831853 - this.clock * 0.65;
                var shot_speed: f32 = velocity;
                if this.kind == 2.0 && slot % 2.0 == 1.0 { shot_speed += 1.15; }
                fire_at(this.transform.position.x, this.transform.position.y,
                        angle, shot_speed, 1.0);
            }
            slot += 1.0;
        }
        Audio.play("audio/boss.wav", 0.4);
    }

    fn fire_at(x: f32, y: f32, angle: f32, velocity: f32, damage: f32) {
        let bolt = World.spawn(this.shot);
        bolt.transform.position.x = x + cos(angle) * 0.65;
        bolt.transform.position.y = y + sin(angle) * 0.65;
        World.set_property(bolt, "dir_x", cos(angle));
        World.set_property(bolt, "dir_y", sin(angle));
        World.set_property(bolt, "speed", velocity);
        World.set_property(bolt, "damage", damage);
    }

    fn receive_hits(player: Entity) {
        for hit in Physics.sensor_entered() {
            if hit == player {
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), this.touch_damage));
            } else if World.exists(hit) && World.has_tag(hit, "player_damage") {
                let damage = World.property_number(hit, "damage", 0.0);
                this.hp -= damage;
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
    }

    fn visible_half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 * aspect; }
        return this.view_size * 0.5;
    }

    fn visible_half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5; }
        return this.view_size * 0.5 / aspect;
    }

    fn is_visible() -> bool {
        let half_x = visible_half_x();
        let half_y = visible_half_y();
        let radius = max(abs(this.transform.scale.x), abs(this.transform.scale.y)) * 0.5;
        return this.transform.position.x + radius >= -half_x &&
               this.transform.position.x - radius <= half_x &&
               this.transform.position.y + radius >= -half_y &&
               this.transform.position.y - radius <= half_y;
    }

    fn die() {
        if this.death_burst_damage > 0.0 {
            let wave = World.spawn(this.death_burst);
            wave.transform.position.x = this.transform.position.x;
            wave.transform.position.y = this.transform.position.y;
            World.set_property(wave, "damage", this.death_burst_damage);
        }
        Effects.burst(this.entity);
        Audio.play("audio/kill.wav", 0.6);
        Game.set("kills", Game.get("kills", 0.0) + 1.0);
        Game.set("score", Game.get("score", 0.0) + this.worth * 10.0);
        Game.set("boss_hp", 0.0);
        Game.set("boss_max", 0.0);

        var made: f32 = 0.0;
        while made < 8.0 {
            let angle = made / 8.0 * 6.2831853;
            let drop = World.spawn(this.core);
            drop.transform.position.x = this.transform.position.x + cos(angle) * 1.2;
            drop.transform.position.y = this.transform.position.y + sin(angle) * 1.2;
            World.set_property(drop, "worth", 5.0);
            made += 1.0;
        }
        let roll = World.spawn(this.drop_roll);
        roll.transform.position.x = this.transform.position.x;
        roll.transform.position.y = this.transform.position.y;
        World.set_property(roll, "boss", 1.0);
        World.despawn(this.entity);
    }
}
