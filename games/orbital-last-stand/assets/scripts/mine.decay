// Left in the ship's wake. Anchor Clock shortens the fuse and enlarges the
// collapse, matching the module's promise instead of merely changing its card.
script Mine {
    @export let damage: f32 = 0.65;
    @export let arm_after: f32 = 0.35;
    @export let life: f32 = 7.0;
    @export let blast: Prefab;
    @export let flash: Prefab;

    var age: f32 = 0.0;
    var tripped: bool = false;
    var trail: Entity = null;
    var spark_clock: f32 = 0.0;

    fn start() {
        this.trail = World.find("TrailMagenta");
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 { return; }
        this.age += dt;
        this.transform.rotation_z += dt * 1.8;
        this.shape.dashes = 6.0;
        this.shape.sweep_start = this.age * 0.22;
        this.spark_clock -= dt;
        if this.trail != null && this.spark_clock <= 0.0 {
            this.spark_clock = 0.11;
            Effects.burst_at(this.trail, this.transform.position.x, this.transform.position.y);
        }
        for enemy in Physics.sensor_entered() { this.tripped = true; }
        var arm: f32 = this.arm_after;
        if Game.get("special_anchor_clock", 0.0) > 0.0 { arm *= 0.65; }
        if this.age < arm {
            this.shape.fill.a = 0.2 + this.age / arm * 0.6;
        } else {
            this.shape.fill.a = 1.0;
            if this.tripped { detonate(); return; }
        }
        if this.age >= this.life { World.despawn(this.entity); }
    }

    fn detonate() {
        // The drawn blast, on top of the shockwave the blast prefab already
        // is. It despawns itself when its clip ends rather than being timed
        // from here, so re-timing the animation does not mean editing this.
        if this.flash != null {
            let boom = World.spawn(this.flash);
            boom.transform.position.x = this.transform.position.x;
            boom.transform.position.y = this.transform.position.y;
        }
        let wave = World.spawn(this.blast);
        wave.transform.position.x = this.transform.position.x;
        wave.transform.position.y = this.transform.position.y;
        if Game.get("special_anchor_clock", 0.0) > 0.0 {
            wave.transform.scale.x *= 1.27;
            wave.transform.scale.y *= 1.27;
        }
        World.set_property(wave, "damage", this.damage);
        Effects.burst(this.entity);
        Game.set("screen_trauma", max(Game.get("screen_trauma", 0.0), 0.42));
        World.despawn(this.entity);
    }
}
