// Decorative child used by elite enemies. The parent owns gameplay; this only
// reproduces the reference's independently animated elite outline treatment.
script EliteVisual {
    @export let mode: f32 = 0.0;
    @export let sides: f32 = 6.0;
    @export let trait: f32 = 0.0;
    @export let identity_ring: Prefab;
    @export let identity_crack: Prefab;

    var clock: f32 = 0.0;
    var phase: f32 = 0.0;

    fn start() {
        this.shape.count = this.sides;
        // Reference enemies carry a random phase that offsets their ring pulse.
        // Reuse that same phase for the trait-specific cue so the layers breathe
        // together instead of spending another gameplay RNG draw.
        if this.mode == 1.0 {
            this.phase = Random.range(0.0, 6.2831853);
            spawn_identity();
        }
        apply_color();
    }

    fn update(dt: f32) {
        this.clock += dt;
        apply_color();
        if this.mode == 0.0 {
            // The reference draws this inside the enemy's +0.6 rad/s rotated
            // context, with an additional local -1.4 rad/s turn.
            this.transform.rotation_z = -this.clock * 1.4;
            this.shape.stroke.a = 1.0;
        } else {
            this.shape.stroke.a = 0.4 + 0.25 * sin(this.clock * 7.0 + this.phase);
        }
    }

    fn spawn_identity() {
        // Frenzied has no extra identity mark in the reference renderer beyond
        // the generic elite shell/ring, so trait 1 intentionally stops here.
        if this.trait == 1.0 { return; }
        if this.trait == 0.0 {
            var slot: f32 = 0.0;
            while slot < 3.0 {
                spawn_identity_ring(slot);
                slot += 1.0;
            }
        } else if this.trait == 4.0 {
            var slot: f32 = 0.0;
            while slot < 3.0 {
                let mark = World.spawn(this.identity_crack);
                World.set_property(mark, "trait", this.trait);
                World.set_property(mark, "index", slot);
                World.set_property(mark, "phase", this.phase);
                World.set_parent(mark, this.entity);
                slot += 1.0;
            }
        } else {
            spawn_identity_ring(0.0);
        }
    }

    fn spawn_identity_ring(index: f32) {
        let mark = World.spawn(this.identity_ring);
        World.set_property(mark, "trait", this.trait);
        World.set_property(mark, "index", index);
        World.set_property(mark, "phase", this.phase);
        World.set_parent(mark, this.entity);
    }

    fn apply_color() {
        if this.trait == 0.0 { color(1.0, 0.91, 0.58); }
        else if this.trait == 1.0 { color(1.0, 0.42, 0.45); }
        else if this.trait == 2.0 { color(1.0, 0.69, 0.31); }
        else if this.trait == 3.0 { color(0.84, 0.49, 1.0); }
        else { color(0.45, 1.0, 0.82); }
    }

    fn color(r: f32, g: f32, b: f32) {
        this.shape.stroke.r = r;
        this.shape.stroke.g = g;
        this.shape.stroke.b = b;
    }
}
