// Decorative child used by elite enemies. The parent owns gameplay; this only
// reproduces the reference's independently animated elite outline treatment.
script EliteVisual {
    @export let mode: f32 = 0.0;
    @export let sides: f32 = 6.0;
    @export let trait: f32 = 0.0;
    @export let phase: f32 = 0.0;

    var clock: f32 = 0.0;

    fn start() {
        this.shape.count = this.sides;
        apply_color();
    }

    fn update(dt: f32) {
        this.clock += dt;
        apply_color();
        if this.mode == 0.0 {
            // The reference draws this inside the enemy's +0.6 rad/s rotated
            // context, with an additional local -1.4 rad/s turn.
            this.transform.rotation_z = -this.clock * 1.4;
            this.shape.stroke.a = 1.0;
        } else {
            this.shape.stroke.a = 0.4 + 0.25 * sin(this.clock * 7.0 + this.phase);
        }
    }

    fn apply_color() {
        if this.trait == 0.0 { color(1.0, 0.91, 0.58); }
        else if this.trait == 1.0 { color(1.0, 0.42, 0.45); }
        else if this.trait == 2.0 { color(1.0, 0.69, 0.31); }
        else if this.trait == 3.0 { color(0.84, 0.49, 1.0); }
        else { color(0.45, 1.0, 0.82); }
    }

    fn color(r: f32, g: f32, b: f32) {
        this.shape.stroke.r = r;
        this.shape.stroke.g = g;
        this.shape.stroke.b = b;
    }
}
