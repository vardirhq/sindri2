// Decorative child used by elite enemies. The parent owns gameplay; this layer
// makes elites read instantly through motion, sweep, dashes and breathing scale.
script EliteVisual {
    @export let mode: f32 = 0.0;
    @export let sides: f32 = 6.0;
    @export let trait: f32 = 0.0;
    @export let identity_ring: Prefab;
    @export let identity_crack: Prefab;

    var clock: f32 = 0.0;
    var phase: f32 = 0.0;

    fn start() {
        this.shape.count = this.sides;
        this.phase = Random.range(0.0, 6.2831853);
        if this.mode == 1.0 { spawn_identity(); }
        apply_color();
    }

    fn update(dt: f32) {
        this.clock += dt;
        apply_color();
        let pulse = 0.5 + 0.5 * sin(this.clock * (5.0 + this.trait * 0.75) + this.phase);

        if this.mode == 0.0 {
            let speed = 1.2 + this.trait * 0.28;
            this.transform.rotation_z = -this.clock * speed + this.phase;
            let size = 1.28 + pulse * 0.14;
            this.transform.scale.x = size;
            this.transform.scale.y = size;
            this.shape.dashes = 4.0 + this.trait * 2.0;
            this.shape.dash_duty = 0.34 + pulse * 0.22;
            this.shape.sweep_start = this.clock * (0.08 + this.trait * 0.025);
            this.shape.stroke.a = 0.58 + pulse * 0.42;
            this.shape.stroke_width = 0.055 + pulse * 0.045;
        } else {
            let size = 1.52 + pulse * 0.16;
            this.transform.scale.x = size;
            this.transform.scale.y = size;
            this.transform.rotation_z = this.clock * (0.5 + this.trait * 0.21) + this.phase;
            this.shape.dashes = 8.0 + this.trait * 2.0;
            this.shape.dash_duty = 0.28 + pulse * 0.20;
            this.shape.sweep_start = -this.clock * (0.09 + this.trait * 0.018);
            this.shape.stroke.a = 0.22 + 0.48 * pulse;
            this.shape.stroke_width = 0.035 + pulse * 0.035;
        }
    }

    fn spawn_identity() {
        if this.trait == 1.0 { return; }
        if this.trait == 0.0 {
            var slot: f32 = 0.0;
            while slot < 3.0 { spawn_identity_ring(slot); slot += 1.0; }
        } else if this.trait == 4.0 {
            var slot: f32 = 0.0;
            while slot < 3.0 {
                let mark = World.spawn_child(this.identity_crack, this.entity);
                World.set_property(mark, "trait", this.trait);
                World.set_property(mark, "index", slot);
                World.set_property(mark, "phase", this.phase);
                slot += 1.0;
            }
        } else { spawn_identity_ring(0.0); }
    }

    fn spawn_identity_ring(index: f32) {
        let mark = World.spawn_child(this.identity_ring, this.entity);
        World.set_property(mark, "trait", this.trait);
        World.set_property(mark, "index", index);
        World.set_property(mark, "phase", this.phase);
    }

    fn apply_color() {
        if this.trait == 0.0 { color(1.0, 0.91, 0.58); }
        else if this.trait == 1.0 { color(1.0, 0.42, 0.45); }
        else if this.trait == 2.0 { color(1.0, 0.69, 0.31); }
        else if this.trait == 3.0 { color(0.84, 0.49, 1.0); }
        else { color(0.45, 1.0, 0.82); }
    }

    fn color(r: f32, g: f32, b: f32) {
        this.shape.stroke.r = r;
        this.shape.stroke.g = g;
        this.shape.stroke.b = b;
    }
}
