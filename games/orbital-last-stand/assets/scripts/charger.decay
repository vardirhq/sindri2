// Closes to a distance, holds still long enough to be read, then dashes.
//
// The wind-up is the whole behaviour: an enemy that dashes without one is an
// enemy nobody can avoid, and the tell is what makes it fair.
script Charger {
    @export let health: f32 = 4.0;
    @export let worth: f32 = 2.0;
    @export let approach: f32 = 1.2;
    @export let wind_up: f32 = 0.75;
    @export let dash_speed: f32 = 9.5;
    @export let rest: f32 = 1.1;
    @export let touch_damage: f32 = 1.0;
    @export let core: Prefab;
    @export let death_burst: Prefab;

    var hp: f32 = 0.0;
    var death_burst_damage: f32 = 0.0;
    // 0 closing, 1 winding up, 2 dashing
    var phase: f32 = 0.0;
    var timer: f32 = 0.0;
    var dash_x: f32 = 0.0;
    var dash_y: f32 = 0.0;

    fn start() {
        // Tougher as the run goes on. Without this the player's upgrades
        // outrun the enemies and a late wave evaporates on arrival, which
        // makes a ten-minute run emptier than its first minute.
        this.hp = this.health * (1.0 + Game.get("elapsed", 0.0) * 0.022);
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        let player = World.find("Player");
        if player == null {
            return;
        }
        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);

        if this.phase == 0.0 {
            if far > 0.001 {
                Physics.set_velocity(this.entity, dx / far * this.approach, dy / far * this.approach);
            }
            if far < 5.0 {
                this.phase = 1.0;
                this.timer = this.wind_up;
            }
        } else if this.phase == 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.timer -= dt;
            // Brightening while it winds up, so the tell is visible rather than
            // something the player is expected to have memorised.
            this.shape.stroke.r = 1.0;
            this.shape.stroke.g = 0.35 + this.timer;
            if this.timer <= 0.0 {
                this.phase = 2.0;
                this.timer = 0.55;
                if far > 0.001 {
                    this.dash_x = dx / far;
                    this.dash_y = dy / far;
                }
            }
        } else {
            this.shape.stroke.g = 1.0;
            Physics.set_velocity(this.entity, this.dash_x * this.dash_speed,
                                 this.dash_y * this.dash_speed);
            this.timer -= dt;
            if this.timer <= 0.0 {
                this.phase = 0.0;
                this.timer = this.rest;
            }
        }

        for hit in Physics.sensor_entered() {
            if hit == player {
                // The worst single touch this frame, not the sum of them. The
                // ship gets invulnerability after a hit, so being inside a
                // crowd of thirty is one hit — adding them up made a late
                // wave lethal on the frame it arrived, whatever the hull.
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), this.touch_damage));
                continue;
            }
            if !World.exists(hit) {
                continue;
            }
            if this.hp > 0.0 {
                let damage = damage_from(hit);
                this.hp -= damage;
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
        if this.hp <= 0.0 {
            die();
        }
    }

    fn damage_from(hit: Entity) -> f32 {
        if World.has_tag(hit, "player_damage") {
            return World.property_number(hit, "damage", 0.0);
        }
        return 0.0;
    }

    fn die() {
        burst_on_death();
        Effects.burst(this.entity);
        Audio.play("audio/kill.wav", 0.3);
        Game.set("kills", Game.get("kills", 0.0) + 1.0);
        Game.set("score", Game.get("score", 0.0) + this.worth * 10.0);
        let drop = World.spawn(this.core);
        drop.transform.position.x = this.transform.position.x;
        drop.transform.position.y = this.transform.position.y;
        World.set_property(drop, "worth", this.worth);
        World.despawn(this.entity);
    }

    fn burst_on_death() {
        if this.death_burst_damage <= 0.0 {
            return;
        }
        let wave = World.spawn(this.death_burst);
        wave.transform.position.x = this.transform.position.x;
        wave.transform.position.y = this.transform.position.y;
        World.set_property(wave, "damage", this.death_burst_damage);
    }
}
