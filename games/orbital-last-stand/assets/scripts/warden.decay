// The Warden: three phases, each a different problem.
//
//   1  rotating ring volleys with a moving safe gap
//   2  telegraphed charges followed by a close-range fan
//   3  faster rings and charges, with occasional reinforcements
//
// The phases are health thresholds rather than a timer, so a player who does
// more damage sees the fight change sooner. The health curve is deliberately
// boss-specific: challenge should come from patterns, not from waiting for a
// normal-enemy scaling formula to finish multiplying the health bar.
script Warden {
    @export let health: f32 = 120.0;
    @export let worth: f32 = 40.0;
    @export let touch_damage: f32 = 2.0;
    @export let ring_shots: f32 = 12.0;
    @export let volley_gap: f32 = 2.4;
    @export let approach: f32 = 0.9;
    @export let dash_speed: f32 = 7.0;
    @export let view_size: f32 = 11.0;
    @export let shot: Prefab;
    @export let minion: Prefab;
    @export let core: Prefab;
    @export let death_burst: Prefab;

    var hp: f32 = 0.0;
    var death_burst_damage: f32 = 0.0;
    var phase: f32 = 1.0;
    var previous_phase: f32 = 1.0;
    var until_volley: f32 = 0.0;
    var until_summon: f32 = 0.0;
    var dash_timer: f32 = 0.0;
    var dash_windup: f32 = 0.0;
    var dash_time: f32 = 0.0;
    var dash_x: f32 = 0.0;
    var dash_y: f32 = 0.0;
    var ring_offset: f32 = 0.0;
    var phase_flash: f32 = 0.0;

    fn start() {
        // Boss durability rises much more gently than regular enemies. At the
        // current 180-second encounter this is about 380 HP, enough to show all
        // three phases without turning the first boss into a health sponge.
        this.hp = this.health * (1.0 + Game.get("elapsed", 0.0) * 0.012);
        this.until_volley = 1.2;
        this.until_summon = 5.0;
        this.dash_timer = 1.4;
        Game.set("boss_max", this.hp);
        Game.set("boss_hp", this.hp);
    }

    fn update(dt: f32) {
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }
        let player = World.find("Player");
        if player == null {
            return;
        }

        let share = this.hp / max(Game.get("boss_max", 1.0), 1.0);
        if share <= 0.30 {
            this.phase = 3.0;
        } else if share <= 0.65 {
            this.phase = 2.0;
        } else {
            this.phase = 1.0;
        }
        if this.phase != this.previous_phase {
            this.previous_phase = this.phase;
            this.phase_flash = 0.45;
            this.until_volley = 0.35;
            this.dash_timer = 0.7;
            this.dash_windup = 0.0;
            this.dash_time = 0.0;
            Effects.burst(this.entity);
            Audio.play("audio/boss.wav", 0.55);
        }

        // The body reddens as health falls, while transitions and dash windups
        // flash bright enough to read as tells without adding a text prompt.
        if this.phase_flash > 0.0 {
            this.phase_flash -= dt;
            this.shape.stroke.g = 1.0;
            this.shape.stroke.b = 1.0;
        } else {
            this.shape.stroke.g = 0.28 + share * 0.72;
            this.shape.stroke.b = 0.28 + share * 0.72;
        }

        let dx = player.transform.position.x - this.transform.position.x;
        let dy = player.transform.position.y - this.transform.position.y;
        let far = sqrt(dx * dx + dy * dy);
        let visible = is_visible();

        if this.phase == 1.0 {
            // Phase one is positional: stay at range and find the moving gap in
            // each rotating ring.
            hold_at(dx, dy, far, stand_off());
        } else if !visible {
            // Off-screen enemies may close the distance, but do not begin or
            // continue an attack aimed at the player until they can be seen.
            if far > 0.001 {
                Physics.set_velocity(this.entity, dx / far * this.approach,
                                     dy / far * this.approach);
            }
        } else {
            drive_charge(dt, dx, dy, far);
        }

        if visible {
            this.until_volley -= dt;
        }
        if visible && this.until_volley <= 0.0 {
            fire_ring();
            if this.phase == 3.0 {
                this.until_volley = this.volley_gap * 0.55;
            } else if this.phase == 2.0 {
                this.until_volley = this.volley_gap * 0.9;
            } else {
                this.until_volley = this.volley_gap;
            }
        }

        if this.phase == 3.0 && visible {
            this.until_summon -= dt;
            if this.until_summon <= 0.0 {
                summon();
                this.until_summon = 7.5;
            }
        }

        for hit in Physics.sensor_entered() {
            if hit == player {
                // The worst single touch this frame, not the sum of them. The
                // ship gets invulnerability after a hit, so being inside a
                // crowd is still one hit rather than instant deletion.
                Game.set("player_damage_taken",
                         max(Game.get("player_damage_taken", 0.0), this.touch_damage));
                continue;
            }
            if !World.exists(hit) {
                continue;
            }
            if this.hp > 0.0 {
                let damage = damage_from(hit);
                this.hp -= damage;
                if this.hp <= 0.0 && World.property_number(hit, "nova", 0.0) > 0.0 {
                    this.death_burst_damage = damage * 0.3;
                }
            }
        }
        Game.set("boss_hp", max(this.hp, 0.0));
        if this.hp <= 0.0 {
            die();
        }
    }

    fn drive_charge(dt: f32, dx: f32, dy: f32, far: f32) {
        if this.dash_windup > 0.0 {
            this.dash_windup -= dt;
            Physics.set_velocity(this.entity, 0.0, 0.0);
            this.shape.stroke.g = 1.0;
            this.shape.stroke.b = 1.0;
            if this.dash_windup <= 0.0 {
                this.dash_time = 0.34;
                if this.phase == 3.0 {
                    this.dash_time = 0.42;
                }
            }
            return;
        }
        if this.dash_time > 0.0 {
            this.dash_time -= dt;
            Physics.set_velocity(this.entity, this.dash_x * this.dash_speed,
                                 this.dash_y * this.dash_speed);
            if this.dash_time <= 0.0 {
                fire_fan();
            }
            return;
        }

        this.dash_timer -= dt;
        if this.dash_timer <= 0.0 && far > 0.001 {
            this.dash_x = dx / far;
            this.dash_y = dy / far;
            this.dash_windup = 0.58;
            this.dash_timer = 2.5;
            if this.phase == 3.0 {
                this.dash_windup = 0.40;
                this.dash_timer = 1.8;
            }
            Physics.set_velocity(this.entity, 0.0, 0.0);
            return;
        }

        if far > 0.001 {
            Physics.set_velocity(this.entity, dx / far * this.approach,
                                 dy / far * this.approach);
        }
    }

    /// How far out it may hold and still be on screen.
    fn stand_off() -> f32 {
        let tightest = min(visible_half_x(), visible_half_y());
        let radius = max(abs(this.transform.scale.x), abs(this.transform.scale.y)) * 0.5;
        return min(6.5, max(1.5, tightest - radius));
    }

    fn visible_half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 {
            return this.view_size * 0.5 * aspect;
        }
        return this.view_size * 0.5;
    }

    fn visible_half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 {
            return this.view_size * 0.5;
        }
        return this.view_size * 0.5 / aspect;
    }

    fn is_visible() -> bool {
        let half_x = visible_half_x();
        let half_y = visible_half_y();
        let radius = max(abs(this.transform.scale.x), abs(this.transform.scale.y)) * 0.5;
        return this.transform.position.x + radius >= -half_x &&
               this.transform.position.x - radius <= half_x &&
               this.transform.position.y + radius >= -half_y &&
               this.transform.position.y - radius <= half_y;
    }

    fn damage_from(hit: Entity) -> f32 {
        if World.has_tag(hit, "player_damage") {
            return World.property_number(hit, "damage", 0.0);
        }
        return 0.0;
    }

    fn hold_at(dx: f32, dy: f32, far: f32, want: f32) {
        if far <= 0.001 {
            return;
        }
        var pace: f32 = this.approach;
        if far < want {
            pace = -this.approach;
        }
        Physics.set_velocity(this.entity, dx / far * pace, dy / far * pace);
    }

    // Rings use more slots than bullets, leaving a two-slot safe wedge. The
    // offset advances every volley, so the answer moves rather than becoming a
    // single permanent camping spot.
    fn fire_ring() {
        var slots: f32 = this.ring_shots;
        var speed: f32 = 3.2;
        if this.phase == 2.0 {
            slots = this.ring_shots + 2.0;
            speed = 3.6;
        }
        if this.phase == 3.0 {
            slots = this.ring_shots + 6.0;
            speed = 4.0;
        }

        let bullets = slots - 2.0;
        var made: f32 = 0.0;
        Audio.play("audio/boss.wav", 0.4);
        while made < bullets {
            let angle = made / slots * 6.2831853 + this.ring_offset;
            let bolt = World.spawn(this.shot);
            bolt.transform.position.x = this.transform.position.x + cos(angle) * 0.8;
            bolt.transform.position.y = this.transform.position.y + sin(angle) * 0.8;
            World.set_property(bolt, "dir_x", cos(angle));
            World.set_property(bolt, "dir_y", sin(angle));
            World.set_property(bolt, "speed", speed);
            made += 1.0;
        }
        this.ring_offset += 0.52;
    }

    // A committed dash ends with a compact fan along its travel direction. It
    // punishes standing directly in the lane without flooding the whole arena.
    fn fire_fan() {
        let base = atan2(this.dash_y, this.dash_x);
        var made: f32 = -2.0;
        while made <= 2.0 {
            let angle = base + made * 0.18;
            let bolt = World.spawn(this.shot);
            bolt.transform.position.x = this.transform.position.x + cos(angle) * 0.7;
            bolt.transform.position.y = this.transform.position.y + sin(angle) * 0.7;
            World.set_property(bolt, "dir_x", cos(angle));
            World.set_property(bolt, "dir_y", sin(angle));
            World.set_property(bolt, "speed", 4.2);
            made += 1.0;
        }
        Audio.play("audio/boss.wav", 0.45);
    }

    fn summon() {
        var made: f32 = 0.0;
        while made < 2.0 {
            let angle = Random.range(0.0, 6.2831853);
            let helper = World.spawn(this.minion);
            helper.transform.position.x = this.transform.position.x + cos(angle) * 2.0;
            helper.transform.position.y = this.transform.position.y + sin(angle) * 2.0;
            made += 1.0;
        }
    }

    fn die() {
        burst_on_death();
        Effects.burst(this.entity);
        Audio.play("audio/kill.wav", 0.6);
        Game.set("kills", Game.get("kills", 0.0) + 1.0);
        Game.set("score", Game.get("score", 0.0) + this.worth * 10.0);
        Game.set("boss_hp", 0.0);
        Game.set("boss_max", 0.0);
        Save.set_flag("beat_warden", true);

        var made: f32 = 0.0;
        while made < 8.0 {
            let angle = made / 8.0 * 6.2831853;
            let drop = World.spawn(this.core);
            drop.transform.position.x = this.transform.position.x + cos(angle) * 1.2;
            drop.transform.position.y = this.transform.position.y + sin(angle) * 1.2;
            World.set_property(drop, "worth", 5.0);
            made += 1.0;
        }
        World.despawn(this.entity);
    }

    fn burst_on_death() {
        if this.death_burst_damage <= 0.0 {
            return;
        }
        let wave = World.spawn(this.death_burst);
        wave.transform.position.x = this.transform.position.x;
        wave.transform.position.y = this.transform.position.y;
        World.set_property(wave, "damage", this.death_burst_damage);
    }
}
