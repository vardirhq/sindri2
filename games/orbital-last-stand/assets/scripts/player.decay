// The ship. Moves on the keyboard or towards the pointer, and fires itself at
// whatever is nearest — the reference game aims for you, and a twin-stick
// control the phone cannot offer would be a control the phone cannot offer.
script Player {
    @export let bullet: Prefab;
    @export let mine: Prefab;
    @export let invulnerable_for: f32 = 0.9;
    @export let view_size: f32 = 11.0;
    @export let edge_padding: f32 = 0.28;

    var hurt: Entity = null;
    var target: Entity = null;
    var cooldown: f32 = 0.0;
    var mercy: f32 = 0.0;
    var was_hit: f32 = 0.0;
    var mine_cooldown: f32 = 0.0;
    var facing: f32 = 1.5707963;

    fn start() {
        this.hurt = World.find("PlayerHurt");
        // Reference Strider outline, uniformly scaled from its authored
        // coordinates and Y-flipped from canvas space into Sindri world space.
        World.set_shape_point(0.0, 0.0, 0.5);
        World.set_shape_point(1.0, 0.304, -0.328);
        World.set_shape_point(2.0, 0.1, -0.248);
        World.set_shape_point(3.0, 0.0, -0.392);
        World.set_shape_point(4.0, -0.1, -0.248);
        World.set_shape_point(5.0, -0.304, -0.328);
        this.shape.count = 6.0;
        this.shape.fill.r = 0.470588;
        this.shape.fill.g = 0.921569;
        this.shape.fill.b = 1.0;
        this.shape.fill.a = 1.0;
        this.shape.stroke.r = 0.913725;
        this.shape.stroke.g = 0.992157;
        this.shape.stroke.b = 1.0;
        this.transform.rotation_z = 0.0;
    }

    fn update(dt: f32) {
        if Game.get("player_reset", 0.0) > 0.0 {
            Game.set("player_reset", 0.0);
            this.transform.position.x = 0.0;
            this.transform.position.y = 0.0;
            this.facing = 1.5707963;
            this.transform.rotation_z = 0.0;
            this.mercy = 0.0;
            Game.set("shield_impact", 0.0);
            Physics.set_velocity(this.entity, 0.0, 0.0);
        }
        if Game.get("run_state", 0.0) != 1.0 {
            Physics.set_velocity(this.entity, 0.0, 0.0);
            // Locked physics bodies restore their authored angle before scripts.
            // Keep the remembered heading visible behind pause/upgrade overlays.
            this.transform.rotation_z = this.facing - 1.5707963;
            return;
        }

        move(dt);
        tick_overdrive(dt);
        take_hits();
        track_target();
        shoot(dt);
        drop_mine(dt);

        if this.mercy > 0.0 {
            this.mercy -= dt;
            this.shape.stroke.a = 0.45;
        } else {
            this.shape.stroke.a = 1.0;
        }
    }

    fn move(dt: f32) {
        let speed = Game.get("move_speed", 5.2);
        var dx: f32 = Input.axis("A", "D") + Input.axis("ArrowLeft", "ArrowRight");
        var dy: f32 = Input.axis("S", "W") + Input.axis("ArrowDown", "ArrowUp");
        if dx == 0.0 && dy == 0.0 && Stick.held && !Pointer.over_ui {
            dx = Stick.x;
            dy = -Stick.y;
        }

        let length = sqrt(dx * dx + dy * dy);
        if length >= 0.08 {
            let desired = atan2(dy, dx);
            let delta = atan2(sin(desired - this.facing), cos(desired - this.facing));
            let blend = 1.0 - exp(-12.0 * max(0.0, dt));
            this.facing += delta * blend;
        }
        if length > 1.0 {
            dx /= length;
            dy /= length;
        }

        // Physics owns the body's rotation and restores its locked zero angle
        // before every script pass. Reapply the remembered heading even when
        // there is no input, or an idle ship snaps back to pointing upward.
        this.transform.rotation_z = this.facing - 1.5707963;
        Game.set("player_facing", this.facing);
        Game.set("player_thrust", min(1.0, length));

        // The camera frames a rectangle. The previous circular `arena` both
        // hid the ship beyond a portrait viewport's sides and stopped it far
        // short of the top and bottom. Clamp the complete hull to the exact
        // visible bounds, and cancel only velocity that pushes through them.
        let edge_x = max(0.0, visible_half_x() - this.edge_padding);
        let edge_y = max(0.0, visible_half_y() - this.edge_padding);
        var velocity_x: f32 = dx * speed;
        var velocity_y: f32 = dy * speed;
        if this.transform.position.x <= -edge_x {
            this.transform.position.x = -edge_x;
            if velocity_x < 0.0 { velocity_x = 0.0; }
        } else if this.transform.position.x >= edge_x {
            this.transform.position.x = edge_x;
            if velocity_x > 0.0 { velocity_x = 0.0; }
        }
        if this.transform.position.y <= -edge_y {
            this.transform.position.y = -edge_y;
            if velocity_y < 0.0 { velocity_y = 0.0; }
        } else if this.transform.position.y >= edge_y {
            this.transform.position.y = edge_y;
            if velocity_y > 0.0 { velocity_y = 0.0; }
        }
        Physics.set_velocity(this.entity, velocity_x, velocity_y);
    }

    fn take_hits() {
        let damage = Game.get("player_damage_taken", 0.0);
        if damage > 0.0 {
            Game.set("player_damage_taken", 0.0);
            if this.mercy <= 0.0 {
                Game.set("hp", Game.get("hp", 1.0) - damage);
                Game.set("shield_impact", 1.0);
                this.mercy = this.invulnerable_for;
                Effects.burst(this.hurt);
                Audio.play("audio/hurt.wav", 0.5);
            }
        }
    }

    fn shoot(dt: f32) {
        this.cooldown -= dt;
        if Game.get("nullified", 0.0) > 0.0 {
            return;
        }
        if this.cooldown > 0.0 {
            return;
        }
        let target = this.target;
        if target == null {
            return;
        }
        let overdrive = Game.get("overdrive", 0.0);
        if overdrive > 0.0 {
            this.cooldown = Game.get("fire_gap", 0.42) * 0.55;
        } else {
            this.cooldown = Game.get("fire_gap", 0.42);
        }

        let to_x = target.transform.position.x - this.transform.position.x;
        let to_y = target.transform.position.y - this.transform.position.y;
        let far = sqrt(to_x * to_x + to_y * to_y);
        if far <= 0.0 {
            return;
        }

        let forward_x = to_x / far;
        let forward_y = to_y / far;
        let count = max(1.0, Game.get("shots", 1.0));
        var made: f32 = 0.0;
        while made < count {
            let spread = (made - (count - 1.0) * 0.5) * 0.16;
            let aim_x = forward_x - forward_y * spread;
            let aim_y = forward_y + forward_x * spread;
            let aim_length = sqrt(aim_x * aim_x + aim_y * aim_y);
            var damage = Game.get("damage", 1.0);
            if Random.value() < Game.get("crit", 0.0) {
                damage *= Game.get("crit_power", 2.0);
            }

            let shot = World.spawn(this.bullet);
            shot.transform.position.x = this.transform.position.x;
            shot.transform.position.y = this.transform.position.y;
            let size = Game.get("bullet_size", 1.0);
            shot.transform.scale.x *= size;
            shot.transform.scale.y *= size;
            World.set_property(shot, "dir_x", aim_x / aim_length);
            World.set_property(shot, "dir_y", aim_y / aim_length);
            World.set_property(shot, "speed", Game.get("bullet_speed", 9.0));
            World.set_property(shot, "damage", damage);
            World.set_property(shot, "pierce", Game.get("pierce", 0.0));
            World.set_property(shot, "missile", Game.get("missile", 0.0));
            World.set_property(shot, "arc", Game.get("arc", 0.0));
            World.set_property(shot, "nova", Game.get("nova", 0.0));
            World.set_property(shot, "beam", Game.get("beam", 0.0));
            made += 1.0;
        }
        Audio.play("audio/shot.wav", 0.18);
    }

    fn tick_overdrive(dt: f32) {
        let left = Game.get("overdrive", 0.0);
        if left > 0.0 { Game.set("overdrive", max(0.0, left - dt)); }
    }

    fn track_target() {
        this.target = nearest();
        let target = this.target;
        if target == null {
            Game.set("target_live", 0.0);
            return;
        }
        Game.set("target_live", 1.0);
        Game.set("target_x", target.transform.position.x);
        Game.set("target_y", target.transform.position.y);
    }

    fn drop_mine(dt: f32) {
        if Game.get("nullified", 0.0) > 0.0 {
            return;
        }
        if Game.get("mines", 0.0) <= 0.0 {
            return;
        }
        this.mine_cooldown -= dt;
        if this.mine_cooldown > 0.0 {
            return;
        }
        this.mine_cooldown = 2.4;
        let mine = World.spawn(this.mine);
        mine.transform.position.x = this.transform.position.x;
        mine.transform.position.y = this.transform.position.y;
        World.set_property(mine, "damage", Game.get("damage", 1.0) * 0.65);
    }

    fn nearest() -> Entity {
        var best: Entity = null;
        var best_distance: f32 = 0.0;
        for enemy in World.with_tag("enemy") {
            if !World.exists(enemy) {
                continue;
            }
            if !is_visible(enemy) {
                continue;
            }
            let dx = enemy.transform.position.x - this.transform.position.x;
            let dy = enemy.transform.position.y - this.transform.position.y;
            let distance = dx * dx + dy * dy;
            if best == null || distance < best_distance {
                best = enemy;
                best_distance = distance;
            }
        }
        return best;
    }

    fn is_visible(enemy: Entity) -> bool {
        let half_x = visible_half_x();
        let half_y = visible_half_y();
        let radius = max(abs(enemy.transform.scale.x), abs(enemy.transform.scale.y)) * 0.5;
        return enemy.transform.position.x + radius >= -half_x &&
               enemy.transform.position.x - radius <= half_x &&
               enemy.transform.position.y + radius >= -half_y &&
               enemy.transform.position.y - radius <= half_y;
    }

    fn visible_half_x() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5 * aspect; }
        return this.view_size * 0.5;
    }

    fn visible_half_y() -> f32 {
        let aspect = max(Viewport.aspect, 0.001);
        if aspect >= 1.0 { return this.view_size * 0.5; }
        return this.view_size * 0.5 / aspect;
    }
}
