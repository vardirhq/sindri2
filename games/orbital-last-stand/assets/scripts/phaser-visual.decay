// Decorative Phaser mark from the reference renderer. The parent supplies the
// archetype's normal +0.6 rad/s rotation; this child only pulses the outer
// triangle's opacity.
script PhaserVisual {
    var clock: f32 = 0.0;

    fn update(dt: f32) {
        this.clock += dt;
        this.shape.stroke.a = 0.35 + 0.25 * sin(this.clock * 12.0);
    }
}
