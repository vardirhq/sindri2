// Full Last Stand module chooser. The scene still owns four reusable card slots;
// this script supplies the 160-item reference catalog, weighted pools and ownership.
script UpgradeChooser {
    @export let offers: f32 = 3.0;

    var catalog: Array<Entity>;
    var screen: Entity = null;
    var card0: Entity = null;
    var card1: Entity = null;
    var card2: Entity = null;
    var card3: Entity = null;
    var name0: Entity = null;
    var name1: Entity = null;
    var name2: Entity = null;
    var name3: Entity = null;
    var blurb0: Entity = null;
    var blurb1: Entity = null;
    var blurb2: Entity = null;
    var blurb3: Entity = null;
    var showing: bool = false;

    fn start() {
        this.catalog = World.with_tag("upgrade");
        this.screen = World.find("Upgrades");
        this.card0 = World.find("Guidance Kernel");
        this.card1 = World.find("Arc Imprint");
        this.card2 = World.find("Nova Imprint");
        this.card3 = World.find("Gravity Anchor");
        this.name0 = World.find("Guidance Kernel Name");
        this.name1 = World.find("Arc Imprint Name");
        this.name2 = World.find("Nova Imprint Name");
        this.name3 = World.find("Gravity Anchor Name");
        this.blurb0 = World.find("Guidance Kernel Blurb");
        this.blurb1 = World.find("Arc Imprint Blurb");
        this.blurb2 = World.find("Nova Imprint Blurb");
        this.blurb3 = World.find("Gravity Anchor Blurb");
        hide();
    }

    fn update(dt: f32) {
        if Game.get("modules_reset", 0.0) > 0.0 {
            Game.set("modules_reset", 0.0);
            Game.set("owned_modules_0", 0.0);
            Game.set("owned_modules_1", 0.0);
            Game.set("owned_modules_2", 0.0);
            Game.set("owned_modules_3", 0.0);
            Game.set("black_modules_taken", 0.0);
            Game.set("picked_module", -1.0);
        }
        let choosing = Game.get("run_state", 0.0) == 2.0;
        if choosing == this.showing { return; }
        if this.showing && !choosing {
            let picked = Game.get("picked_module", -1.0);
            if picked >= 0.0 { mark_owned(picked); }
            Game.set("picked_module", -1.0);
        }
        this.showing = choosing;
        if !choosing { hide(); return; }
        show();
    }

    fn hide() {
        for card in this.catalog { World.set_active(card, false); }
        World.set_active(this.screen, false);
    }

    fn show() {
        for card in this.catalog { World.set_active(card, false); }
        World.set_active(this.screen, true);
        let pool = Game.get("module_pool", 0.0);
        let count = offer_count();
        let first = choose(pool, -1.0, -1.0, -1.0);
        let second = choose(pool, first, -1.0, -1.0);
        let third = choose(pool, first, second, -1.0);
        Game.set("offer_0", first);
        Game.set("offer_1", second);
        Game.set("offer_2", third);
        paint(this.name0, this.blurb0, first);
        paint(this.name1, this.blurb1, second);
        paint(this.name2, this.blurb2, third);
        World.set_active(this.card0, true);
        World.set_active(this.card1, true);
        World.set_active(this.card2, true);
        if count > 3.0 {
            let fourth = choose(pool, first, second, third);
            Game.set("offer_3", fourth);
            paint(this.name3, this.blurb3, fourth);
            World.set_active(this.card3, true);
        } else {
            Game.set("offer_3", -1.0);
            World.set_active(this.card3, false);
        }
    }

    fn offer_count() -> f32 {
        if Game.get("special_second_opinion", 0.0) > 0.0 { return 4.0; }
        return this.offers;
    }

    fn choose(pool: f32, a: f32, b: f32, c: f32) -> f32 {
        var tries: f32 = 0.0;
        while tries < 512.0 {
            tries += 1.0;
            let id = Random.int(0.0, 159.0);
            if id == a || id == b || id == c || owned(id) || !eligible(id, pool) { continue; }
            if Random.value() <= rarity_weight(id) / 8.0 { return id; }
        }
        var id: f32 = 0.0;
        while id < 160.0 {
            if id != a && id != b && id != c && !owned(id) && eligible(id, pool) { return id; }
            id += 1.0;
        }
        return Random.int(0.0, 159.0);
    }

    fn eligible(id: f32, pool: f32) -> bool {
        if pool == 3.0 {
            if !is_black(id) { return false; }
            if id == 139.0 && Game.get("black_modules_taken", 0.0) < 2.0 { return false; }
            return true;
        }
        if is_black(id) { return false; }
        if pool == 2.0 { return is_companion(id); }
        if pool == 1.0 { return is_special(id) || id % 11.0 == 0.0; }
        return !(is_special(id) && id > 129.0);
    }

    fn rarity_weight(id: f32) -> f32 {
        if id == 139.0 { return 0.12; }
        if is_special(id) {
            if id > 129.0 { return 0.7; }
            return 2.0;
        }
        if id % 11.0 == 0.0 { return 2.0; }
        if id % 4.0 == 0.0 { return 5.0; }
        return 8.0;
    }

    fn is_black(id: f32) -> bool {
        return id == 90.0 || id == 91.0 || id == 92.0 || id == 93.0 || id == 101.0 || id == 110.0 || id == 111.0 || id == 113.0 || id == 114.0 || id == 131.0 || id == 139.0;
    }

    fn is_special(id: f32) -> bool {
        return id == 90.0 || id == 91.0 || id == 92.0 || id == 93.0 || id == 94.0 || id == 95.0 || id == 96.0 || id == 97.0 || id == 98.0 || id == 99.0 || id == 100.0 || id == 101.0 ||
               id == 102.0 || id == 103.0 || id == 104.0 || id == 105.0 || id == 106.0 || id == 107.0 || id == 108.0 || id == 109.0 || id == 110.0 || id == 111.0 || id == 112.0 || id == 113.0 ||
               id == 114.0 || id == 115.0 || id == 116.0 || id == 117.0 || id == 118.0 || id == 119.0 || id == 120.0 || id == 121.0 || id == 122.0 || id == 123.0 || id == 124.0 || id == 125.0 ||
               id == 126.0 || id == 127.0 || id == 128.0 || id == 129.0 || id == 130.0 || id == 131.0 || id == 132.0 || id == 133.0 || id == 134.0 || id == 135.0 || id == 136.0 || id == 137.0 ||
               id == 138.0 || id == 139.0 || id == 140.0 || id == 141.0 || id == 142.0 || id == 150.0 || id == 151.0 || id == 152.0 || id == 153.0 || id == 154.0 || id == 155.0 || id == 156.0 ||
               id == 157.0 || id == 158.0 || id == 159.0;
    }

    fn is_companion(id: f32) -> bool {
        return id == 35.0 || id == 36.0 || id == 37.0 || id == 38.0 || id == 39.0 || id == 107.0 || id == 108.0 || id == 109.0 || id == 122.0 || id == 123.0 || id == 124.0 || id == 125.0 ||
               id == 126.0 || id == 127.0 || id == 128.0 || id == 129.0 || id == 130.0 || id == 132.0 || id == 137.0 || id == 138.0 || id == 139.0 || id == 146.0 || id == 152.0 || id == 153.0 ||
               id == 159.0;
    }

    fn owned(id: f32) -> bool {
        let chunk = (id - id % 40.0) / 40.0;
        let bit = id % 40.0;
        let power = power2(bit);
        var value: f32 = Game.get("owned_modules_0", 0.0);
        if chunk == 1.0 { value = Game.get("owned_modules_1", 0.0); }
        else if chunk == 2.0 { value = Game.get("owned_modules_2", 0.0); }
        else if chunk == 3.0 { value = Game.get("owned_modules_3", 0.0); }
        let whole = (value - value % power) / power;
        return whole % 2.0 >= 1.0;
    }

    fn mark_owned(id: f32) {
        if owned(id) { return; }
        let chunk = (id - id % 40.0) / 40.0;
        let power = power2(id % 40.0);
        if chunk == 0.0 { Game.set("owned_modules_0", Game.get("owned_modules_0", 0.0) + power); }
        else if chunk == 1.0 { Game.set("owned_modules_1", Game.get("owned_modules_1", 0.0) + power); }
        else if chunk == 2.0 { Game.set("owned_modules_2", Game.get("owned_modules_2", 0.0) + power); }
        else { Game.set("owned_modules_3", Game.get("owned_modules_3", 0.0) + power); }
        if is_black(id) { Game.set("black_modules_taken", Game.get("black_modules_taken", 0.0) + 1.0); }
    }

    fn power2(bit: f32) -> f32 {
        var value: f32 = 1.0;
        var i: f32 = 0.0;
        while i < bit { value *= 2.0; i += 1.0; }
        return value;
    }

    fn paint(name: Entity, blurb: Entity, id: f32) {
        Ui.set_text(name, module_name(id));
        Ui.set_text(blurb, module_description(id));
    }

    fn module_name(id: f32) -> String {
