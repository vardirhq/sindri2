    }

    fn module_description(id: f32) -> String {
        if id == 0.0 { return "Damage up."; }
        if id == 2.0 { return "Fire rate up."; }
        if id == 4.0 { return "Projectile speed up."; }
        if id == 5.0 { return "Projectile mass and damage up."; }
        if id == 6.0 { return "Adds one projectile."; }
        if id == 7.0 { return "Adds two projectiles; damage down."; }
        if id == 8.0 { return "Adds one pierce."; }
        if id == 9.0 { return "Adds two pierce; smaller rounds."; }
        if id == 10.0 { return "Critical chance up."; }
        if id == 12.0 { return "Shots seek targets."; }
        if id == 13.0 { return "Impacts chain electrical damage."; }
        if id == 14.0 { return "Impacts burst."; }
        if id == 15.0 { return "Drops gravity anchors."; }
        if id == 16.0 { return "Impacts lance through targets."; }
        if id == 35.0 { return "Adds a Razor orbital."; }
        if id == 36.0 { return "Adds an Aegis orbital."; }
        if id == 37.0 { return "Adds an Ember familiar."; }
        if id == 38.0 { return "Adds a Void Wisp."; }
        if id == 39.0 { return "Adds a Gundrone."; }
        if id == 90.0 { return "Kills repair hull; elites and bosses feed the battery harder."; }
        if id == 91.0 { return "Taking hull damage triggers four seconds of overdrive."; }
        if id == 92.0 { return "Once per run, lethal damage leaves the ship at one hull."; }
        if id == 93.0 { return "Weapon damage rises by 45% below 35% hull integrity."; }
        if id == 94.0 { return "Every salvage gem yields 35% more experience."; }
        if id == 95.0 { return "Level-ups repair 12% hull and purge nearby hostile fire."; }
        if id == 96.0 { return "Piercing rounds gain 12% damage after every target."; }
        if id == 97.0 { return "Projectile speed converts into up to 40% bonus damage."; }
        if id == 98.0 { return "Nova impacts gain 35% radius and 20% damage."; }
        if id == 99.0 { return "Every sixth volley echoes at 60% damage."; }
        if id == 100.0 { return "Extra volley rounds recover 8% damage each, up to 32%."; }
        if id == 101.0 { return "Incoming hits have a 12% chance to phase harmlessly."; }
        if id == 102.0 { return "Arc discharges jump twice farther and hit 20% harder."; }
        if id == 103.0 { return "Prism impacts fire a second beam backwards."; }
        if id == 104.0 { return "Gravity anchors detonate 35% faster with larger collapse radius."; }
        if id == 105.0 { return "Guided projectiles turn 80% faster."; }
        if id == 106.0 { return "Last Stand transmissions offer four module choices."; }
        if id == 107.0 { return "Fabricates one Razor orbital and one Gundrone."; }
        if id == 108.0 { return "Each companion reduces incoming damage by 4%, up to 20%."; }
        if id == 109.0 { return "Each companion increases weapon damage by 5%, up to 30%."; }
        if id == 110.0 { return "A close-range gravity aura burns nearby hostiles."; }
        if id == 111.0 { return "A defensive pulse erases nearby hostile fire every four seconds."; }
        if id == 112.0 { return "Adds two compact rounds and accelerates the firing cycle."; }
        if id == 113.0 { return "Critical needle rounds hit brutally hard at the cost of hull."; }
        if id == 114.0 { return "Massive rounds pierce twice but travel more slowly."; }
        if id == 115.0 { return "Fast phase rounds gain piercing and critical chance."; }
        if id == 116.0 { return "Adds a split volley whose rounds independently seek targets."; }
        if id == 117.0 { return "Completes the circuit required for Seeking Storm."; }
        if id == 118.0 { return "Installs prism and gravity behavior in a single module."; }
        if id == 119.0 { return "Guided rounds carry nova payloads into clustered targets."; }
        if id == 120.0 { return "Piercing rounds leave gravity anchors after their final target."; }
        if id == 121.0 { return "Critical hits overcharge chained arc damage."; }
        if id == 122.0 { return "Razor orbitals scale with heavy payload behavior."; }
        if id == 123.0 { return "Razor orbitals accelerate with projectile velocity."; }
        if id == 124.0 { return "Ember familiars conduct arcs through their targets."; }
        if id == 125.0 { return "Void wisps seed gravity anchors around their pulses."; }
        if id == 126.0 { return "Gundrones inherit split-volley behavior."; }
        if id == 127.0 { return "Aegis pulses carry nova behavior into nearby enemies."; }
        if id == 128.0 { return "Familiars acquire farther targets and attack faster."; }
        if id == 129.0 { return "Razor contacts refract prism damage through the formation."; }
        if id == 130.0 { return "The Aegis field becomes an electrical conductor."; }
        if id == 131.0 { return "Boss kills reinforce maximum hull and fully repair the ship."; }
        if id == 132.0 { return "Completes the Ember, Wisp and arc circuit for Thunder Choir."; }
        if id == 133.0 { return "Completes payload, nova, gravity and phase behavior."; }
        if id == 134.0 { return "Completes fork, phase, guidance and arc behavior."; }
        if id == 135.0 { return "Completes velocity, phase and prism behavior."; }
        if id == 136.0 { return "Completes payload, critical and nova behavior."; }
        if id == 137.0 { return "Completes Aegis, Gundrone and fork behavior."; }
        if id == 138.0 { return "Completes Wisp, gravity, nova and payload behavior."; }
        if id == 139.0 { return "Activates every apex transformation and an annihilation aura."; }
        if id == 140.0 { return "Reveals hidden Null Chamber doors and makes them substantially more common."; }
        if id == 141.0 { return "Module vaults reveal one additional pedestal."; }
        if id == 142.0 { return "Scrap Exchange prices fall by 30% and Quiet Docks repair more hull."; }
        if id == 146.0 { return "Adds a Wrecking Node."; }
        if id == 150.0 { return "Expired rounds become stars; every three connect into a damaging constellation."; }
        if id == 151.0 { return "Rounds reverse in flight, returning through the arena with more damage and piercing."; }
        if id == 152.0 { return "Aegis stores intercepted hostile rounds and retaliates with captured energy."; }
        if id == 153.0 { return "Companions weave damaging energy threads through the space between them."; }
        if id == 154.0 { return "Friendly cannons periodically occupy both arena edges and fire across three lanes."; }
        if id == 155.0 { return "Elites, bosses and every tenth kill leave temporary ghosts that fire for the ship."; }
        if id == 156.0 { return "Friendly rounds leaving the arena wrap through the opposite edge once."; }
        if id == 157.0 { return "A dark familiar consumes friendly rounds and releases a colossal lance."; }
        if id == 158.0 { return "Periodically gathers nearby rounds into orbit before releasing them as a spiral."; }
        if id == 159.0 { return "Marks one target for familiar focus; its death detonates the mark and passes it onward."; }
        let kind = id % 15.0;
        if kind == 0.0 { return "Damage up."; }
        if kind == 1.0 { return "Fire rate up."; }
        if kind == 2.0 { return "Projectile speed up."; }
        if kind == 3.0 { return "Projectile mass up."; }
        if kind == 4.0 { return "Hull integrity up."; }
        if kind == 5.0 { return "Repairs hull."; }
        if kind == 6.0 { return "Hull regeneration up."; }
        if kind == 7.0 { return "Damage resistance up."; }
        if kind == 8.0 { return "Movement speed up."; }
        if kind == 9.0 { return "Salvage collection up."; }
        if kind == 10.0 { return "Experience yield up."; }
        if kind == 11.0 { return "Critical chance up."; }
        if kind == 12.0 { return "Damage and projectile speed up."; }
        if kind == 13.0 { return "Hull and armor up."; }
        return "Fire rate and movement speed up.";
    }
}
